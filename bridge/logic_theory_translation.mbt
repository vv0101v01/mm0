///|
// Logical Theory Translation Engine across Cubical Type Theory (@cub),
// Grothendieck & Elementary Topos Logic (@topos), Algebraic Schemes & Gröbner
// Ideals (@scheme), and Idempotent / Tropical Semirings (@snf, @strop).

///|
/// Translate a CCHM cubical dimension expression `d : @cub.Dim` in `nvars`
/// interval variables into its algebraic polynomial interpretation `P(d) ∈ Q[x_0..x_{nvars-1}]`:
///   - `0 ↦ 0`, `1 ↦ 1`, `i ↦ x_i`,
///   - `~d ↦ 1 - P(d)`,
///   - `d1 ∧ d2 ↦ P(d1) * P(d2)`,
///   - `d1 ∨ d2 ↦ P(d1) + P(d2) - P(d1) * P(d2)`.
pub fn translate_cubical_dim_to_mpoly(
  d : @cub.Dim,
  nvars : Int32,
) -> @scheme.MPoly {
  match d {
    DZero => @scheme.mpoly_int(nvars, 0)
    DOne => @scheme.mpoly_int(nvars, 1)
    DVar(i) => @scheme.mpoly_var(nvars, i)
    DNeg(sub) =>
      @scheme.mpoly_sub(
        @scheme.mpoly_int(nvars, 1),
        translate_cubical_dim_to_mpoly(sub, nvars),
      )
    DAnd(a, b) =>
      @scheme.mpoly_mul(
        translate_cubical_dim_to_mpoly(a, nvars),
        translate_cubical_dim_to_mpoly(b, nvars),
      )
    DOr(a, b) => {
      let pa = translate_cubical_dim_to_mpoly(a, nvars)
      let pb = translate_cubical_dim_to_mpoly(b, nvars)
      @scheme.mpoly_sub(@scheme.mpoly_add(pa, pb), @scheme.mpoly_mul(pa, pb))
    }
  }
}

///|
/// **Stone–Zariski–CCHM Face-to-Scheme Ideal Translation**:
/// Translates any cubical cofibration face formula `φ : @cub.Face` into its
/// closed subscheme ideal `I(φ) ⊆ Q[x_0..x_{nvars-1}]` (`∧` -> sum of ideals,
/// `∨` -> elimination intersection of ideals)!
/// When `boolean_vertices_only == true`, restricts to the Boolean cube
/// `V(x_0^2 - x_0, ..., x_{nvars-1}^2 - x_{nvars-1})` so `RGB(I(φ)) == RGB(I(ψ))`
/// holds iff `@cub.bdd_face_eq(φ, ψ, nvars)`!
/// When `boolean_vertices_only == false`, works on the full affine cube `A^n_Q`,
/// faithfully distinguishing `(i = 0) ∨ (i = 1)` (`<x_i^2 - x_i> != <0>`) from `⊤`
/// (`<0>`) while still collapsing `(i = 0) ∧ (i = 1)` to `<1>` (`∅`)!
pub fn translate_cubical_face_to_zariski_ideal(
  face : @cub.Face,
  nvars : Int32,
  boolean_vertices_only : Bool,
) -> @scheme.Ideal {
  let raw_idl = match face {
    FTop => @scheme.ideal_new(nvars, [])
    FBot => @scheme.ideal_new(nvars, [@scheme.mpoly_int(nvars, 1)])
    FEq0(d) =>
      @scheme.ideal_new(nvars, [translate_cubical_dim_to_mpoly(d, nvars)])
    FEq1(d) =>
      @scheme.ideal_new(nvars, [
        @scheme.mpoly_sub(
          translate_cubical_dim_to_mpoly(d, nvars),
          @scheme.mpoly_int(nvars, 1),
        ),
      ])
    FAnd(a, b) =>
      @scheme.ideal_add(
        translate_cubical_face_to_zariski_ideal(a, nvars, boolean_vertices_only),
        translate_cubical_face_to_zariski_ideal(b, nvars, boolean_vertices_only),
      )
    FOr(a, b) =>
      @scheme.ideal_intersect(
        translate_cubical_face_to_zariski_ideal(a, nvars, boolean_vertices_only),
        translate_cubical_face_to_zariski_ideal(b, nvars, boolean_vertices_only),
      )
  }
  if boolean_vertices_only {
    let bool_gens : Array[@scheme.MPoly] = []
    for i in 0..<nvars {
      let xi = @scheme.mpoly_var(nvars, i)
      bool_gens.push(@scheme.mpoly_sub(@scheme.mpoly_pow(xi, 2), xi))
    }
    @scheme.ideal_radical(
      @scheme.ideal_add(raw_idl, @scheme.ideal_new(nvars, bool_gens)),
    )
  } else {
    raw_idl
  }
}

///|
/// Translate a cubical cofibration `face : @cub.Face` (over atomic dimension
/// variables `DVar(i)`) into a Geometric Formula `@topos.GeoFormula` where
/// predicate `2 * i` represents `(i = 0)` and `2 * i + 1` represents `(i = 1)`!
pub fn translate_cubical_face_to_geo_formula(
  face : @cub.Face,
) -> @topos.GeoFormula {
  fn dim_eq(d : @cub.Dim, target_one : Bool) -> @topos.GeoFormula {
    match d {
      DZero => if target_one { GFalse } else { GTrue }
      DOne => if target_one { GTrue } else { GFalse }
      DVar(i) => GPred(if target_one { 2 * i + 1 } else { 2 * i }, [])
      DNeg(sub) => dim_eq(sub, !target_one)
      DAnd(a, b) =>
        if target_one {
          GAnd(dim_eq(a, true), dim_eq(b, true))
        } else {
          GOr([dim_eq(a, false), dim_eq(b, false)])
        }
      DOr(a, b) =>
        if target_one {
          GOr([dim_eq(a, true), dim_eq(b, true)])
        } else {
          GAnd(dim_eq(a, false), dim_eq(b, false))
        }
    }
  }
  match face {
    FTop => GTrue
    FBot => GFalse
    FEq0(d) => dim_eq(d, false)
    FEq1(d) => dim_eq(d, true)
    FAnd(a, b) =>
      GAnd(
        translate_cubical_face_to_geo_formula(a),
        translate_cubical_face_to_geo_formula(b),
      )
    FOr(a, b) =>
      GOr([
        translate_cubical_face_to_geo_formula(a),
        translate_cubical_face_to_geo_formula(b),
      ])
  }
}

///|
/// Construct the **CCHM Interval Classifying Topos** `B(T_{CCHM, nvars})`
/// generated by `2 * nvars` propositional atoms `(i = 0), (i = 1)` subject ONLY
/// to the disjoint-endpoint geometric sequents `(i = 0) ∧ (i = 1) ⊢ ⊥`!
/// Notice `⊤ ⊢ (i = 0) ∨ (i = 1)` is NOT imposed, so each interval has 3 points
/// in Set (`i = 0`, `i = 1`, and generic interior `0 < i < 1`), yielding `3^{nvars}`
/// Diaconescu points!
pub fn build_cchm_interval_classifying_topos(nvars : Int32) -> @topos.Site {
  let axioms : Array[@topos.PropGeoAxiom] = []
  for i in 0..<nvars {
    axioms.push({ premise_atoms: [2 * i, 2 * i + 1], branches: [], })
  }
  let data = @topos.build_propositional_classifying_topos({
    num_props: 2 * nvars,
    axioms,
  })
  data.site
}

///|
/// **Curry–Howard–Lambek–Joyal Translation** from Constructive Dependent Type
/// Theory (`@cub.DTerm` propositions-as-types fragment) into Internal Topos
/// Heyting/First-Order Logic (`@topos.GeoFormula`):
///   - `DUnitTy ↦ GTrue` (`1` = terminal truth),
///   - `DBoolTy ↦ GOr([GPred(0, []), GImplies(GPred(0, []), GFalse)])`? Wait:
///     for clean syntactic propositions:
///     * `DUnitTy ↦ GTrue`,
///     * `DTVar(p_idx) ↦ GPred(p_idx, [])` (propositional / atomic predicate),
///     * `DPi(dom, cod)`: if `dom` is an individual sort (`DNatTy` / `DCircleTy`),
///       translates to universal quantification `GForall(⟦cod⟧)`; otherwise
///       translates to intuitionistic implication `GImplies(⟦dom⟧, ⟦cod⟧)`!
///     * `DSigma(dom, cod)`: if `dom` is an individual sort (`DNatTy` / `DCircleTy`),
///       translates to existential quantification `GExists(⟦cod⟧)`; otherwise
///       translates to conjunction `GAnd(⟦dom⟧, ⟦cod⟧)`!
///     * `DPath(_, DTVar(x), DTVar(y)) ↦ GEq(x, y)` (identity path type -> internal equality!).
pub fn translate_cubical_dterm_to_geo_formula(
  term : @cub.DTerm,
) -> @topos.GeoFormula {
  fn is_object_domain(dom : @cub.DTerm) -> Bool {
    match dom {
      DNatTy | DCircleTy | DTorusTy | DInductive(_, _) => true
      _ => false
    }
  }
  match term {
    DUnitTy => GTrue
    DBoolLit(true) => GTrue
    DBoolLit(false) => GFalse
    DTVar(idx) => GPred(idx, [])
    DPi(dom, cod) =>
      if is_object_domain(dom) {
        GForall(translate_cubical_dterm_to_geo_formula(cod))
      } else {
        GImplies(
          translate_cubical_dterm_to_geo_formula(dom),
          translate_cubical_dterm_to_geo_formula(cod),
        )
      }
    DSigma(dom, cod) =>
      if is_object_domain(dom) {
        GExists(translate_cubical_dterm_to_geo_formula(cod))
      } else {
        GAnd(
          translate_cubical_dterm_to_geo_formula(dom),
          translate_cubical_dterm_to_geo_formula(cod),
        )
      }
    DPath(_, DTVar(x), DTVar(y)) => GEq(x, y)
    DPathP(_, DTVar(x), DTVar(y)) => GEq(x, y)
    _ => GTrue
  }
}

///|
/// **Gödel–Gentzen–Glivenko Double-Negation Translation** `φ ↦ ¬¬φ`
/// (`(φ ⇒ ⊥) ⇒ ⊥`) in internal Heyting logic!
pub fn glivenko_double_negation_formula(
  phi : @topos.GeoFormula,
) -> @topos.GeoFormula {
  let not_phi : @topos.GeoFormula = GImplies(phi, GFalse)
  GImplies(not_phi, GFalse)
}

///|
/// Verify **Glivenko's Theorem & Double-Negation Subtopos Bridge** on the
/// non-Boolean Sierpiński Topos `Sh(0 -> 1)`:
///   1. Build a generic propositional sheaf predicate `P` false at open stage `0`
///      and becoming true at closed/refined stage `1` (`P(0) = ∅, P(1) = {*}` on `1 = {*}`);
///   2. Verify via Kripke–Joyal forcing that Classical Excluded Middle
///      `P ∨ ¬P` **FAILS** at root stage `0` (`0 ⊭ P ∨ (P ⇒ ⊥)`), proving
///      internal topos logic is genuinely intuitionistic!
///   3. Verify that its Glivenko translation `¬¬(P ∨ ¬P)` **HOLDS EVERYWHERE**
///      (`u ⊨ ¬¬(P ∨ ¬P)` for all `u`), AND corresponds geometrically to passing
///      from `Sh(C, J_trivial)` (`is_boolean == false`) to the dense
///      **Double-Negation Lawvere–Tierney Subtopos** `Sh_{¬¬}(C)` (`is_boolean == true`)!
pub fn verify_glivenko_topos_subtopos_bridge() -> Bool {
  let cat = @sym.cat_arrow()
  let j_triv = @topos.topology_trivial(cat)
  let site = @topos.site_new(cat, j_triv)
  // Terminal sheaf `1`: `{0}` at both objects `0` and `1` (`cat_arrow()` has `0 -> 1`,
  // so `f^* : P(1) -> P(0)`; hence `R(0) = {[]}`, `R(1) = ∅` is a valid subpresheaf!).
  let term = @topos.presheaf_terminal(cat)
  let m : @topos.SheafStructure = {
    carrier: term,
    pred_arities: [0],
    relations: [[[[]], []]],
  }
  let p_atom : @topos.GeoFormula = GPred(0, [])
  let not_p : @topos.GeoFormula = GImplies(p_atom, GFalse)
  let lem : @topos.GeoFormula = GOr([p_atom, not_p])
  let gliv_lem = glivenko_double_negation_formula(lem)
  // At stage 1: `P` is false (`R(1) = ∅`), AND `P ⇒ ⊥` checks all `g : v -> 1`:
  // for `g = (0 -> 1)`, `P` IS true at `0`, while `⊥` is false at `0`, so `1 ⊭ ¬P`!
  // Hence `1 ⊭ P ∨ ¬P`!
  let lem_at_1 = @topos.kripke_joyal_forces(site, m, 1, [], lem)
  let gliv_at_0 = @topos.kripke_joyal_forces(site, m, 0, [], gliv_lem)
  let gliv_at_1 = @topos.kripke_joyal_forces(site, m, 1, [], gliv_lem)
  // Geometric side: Sh(cat, j_triv) is NOT Boolean, while dense topology IS Boolean!
  let j_dense = @topos.topology_dense(cat)
  let site_dense = @topos.site_new(cat, j_dense)
  !lem_at_1 &&
  gliv_at_0 &&
  gliv_at_1 &&
  !@topos.is_boolean_topos(site) &&
  @topos.is_boolean_topos(site_dense)
}

///|
/// **Hakim–Zariski Algebraic-to-Logical Theory Translation**:
/// Given a coordinate algebra `ring = Q[x_0..x_{n-1}] / I` and basic open test
/// elements `basic_fs = [f_0, ..., f_{k-1}]`, extracts all exact algebraic
/// radical & partition-of-unity entailments holding in `Spec(ring)` and compiles
/// them into a **Propositional Zariski Geometric Theory** `(k, axioms)` whose
/// Classifying Topos `B(T_{Zar}(ring, basic_fs))` classifies Zariski points!
///   - Atom `i` stands for `[f_i ∈ U^×]` (`x ∈ D(f_i)`).
///   - Nilpotency collapse: if `f_i ∈ √I`, adds `atom_i ⊢ ⊥`.
///   - Inclusion of basic opens: if `D(f_i) ⊆ D(f_j)` (`f_i ∈ √(I + <f_j>)`), adds `atom_i ⊢ atom_j`.
///   - Joint nilpotency: if `f_i * f_j ∈ √I`, adds `atom_i ∧ atom_j ⊢ ⊥`.
///   - Partition-of-unity cover: for any subset `S ⊆ {0..k-1}` whose `{ D(f_s) }_{s ∈ S}`
///     covers `Spec(ring)` (`1 ∈ √(I + <f_s : s ∈ S>)`), adds `⊤ ⊢ ∨_{s ∈ S} atom_s`!
pub fn translate_coord_ring_to_zariski_theory(
  ring : @scheme.CoordRing,
  basic_fs : Array[@scheme.MPoly],
) -> (Int32, Array[@topos.PropGeoAxiom]) {
  let k = basic_fs.length()
  let axioms : Array[@topos.PropGeoAxiom] = []
  // 1. Nilpotency collapse & pairwise open inclusions / disjointness
  for i in 0..<k {
    if @scheme.ideal_radical_contains(ring.ideal, basic_fs[i]) {
      axioms.push({ premise_atoms: [i], branches: [], })
    }
    for j in 0..<k {
      if i != j && @scheme.principal_open_subset(ring, basic_fs[i], basic_fs[j]) {
        axioms.push({ premise_atoms: [i], branches: [[j]], })
      }
    }
    for j in (i + 1)..<k {
      if @scheme.ideal_radical_contains(
          ring.ideal,
          @scheme.mpoly_mul(basic_fs[i], basic_fs[j]),
        ) {
        axioms.push({ premise_atoms: [i, j], branches: [], })
      }
    }
  }
  // 2. Zariski open cover axioms `⊤ ⊢ ∨_{s ∈ S} atom_s`
  let mut total_masks = 1
  for _ in 0..<k {
    total_masks = total_masks * 2
  }
  for mask in 0..<total_masks {
    let sub_fs : Array[@scheme.MPoly] = []
    let branches : Array[Array[Int32]] = []
    for i in 0..<k {
      if ((mask >> i) & 1) == 1 {
        sub_fs.push(basic_fs[i])
        branches.push([i])
      }
    }
    if @scheme.is_zariski_open_cover(ring, sub_fs) {
      axioms.push({ premise_atoms: [], branches, })
    }
  }
  (k, axioms)
}

///|
/// Verify **Grothendieck's Topological Invariance of the Étale/Zariski Topos**
/// vs **Infinitesimal Sensitivity of the Functor of Points**:
/// For a non-reduced affine scheme `X` (e.g. `Spec(Q[x, y] / <x^2, x*(1-y)>)` or
/// `Spec(Q[x] / <x^2 * (x - 1)>)`) and its reduction `X_red`:
///   1. `translate_coord_ring_to_zariski_theory` produces the **EXACT SAME**
///      Zariski geometric theory and Classifying Topos (`Pt(B(T_Zar(X))) == Pt(B(T_Zar(X_red)))`);
///   2. Yet `eval_affine_functor_of_points` over Dual Numbers `F_p[ε]/(ε^2)`
///      strictly distinguishes `X` from `X_red` (`|X(F_p[ε])| > |X_red(F_p[ε])|`)!
pub fn verify_zariski_topos_invariance_vs_nilpotent_points() -> Bool {
  // X = Spec(Q[x] / <x^2 * (x - 1)>): thick double origin x=0 union reduced point x=1!
  let x_var = @scheme.mpoly_var(1, 0)
  let one_minus_x = @scheme.mpoly_sub(@scheme.mpoly_int(1, 1), x_var)
  let gen = @scheme.mpoly_mul(
    @scheme.mpoly_pow(x_var, 2),
    @scheme.mpoly_sub(x_var, @scheme.mpoly_int(1, 1)),
  )
  let x_aff = @scheme.affine_scheme(@scheme.coord_ring_new(1, [gen]))
  let (x_red, _) = @scheme.affine_reduction(x_aff)
  if @scheme.affine_is_reduced(x_aff) || !@scheme.affine_is_reduced(x_red) {
    return false
  }
  let probes = [x_var, one_minus_x]
  let (n1, ax1) = translate_coord_ring_to_zariski_theory(x_aff.ring, probes)
  let (n2, ax2) = translate_coord_ring_to_zariski_theory(x_red.ring, probes)
  if n1 != n2 || ax1 != ax2 {
    return false
  }
  let th_x : @topos.PropGeoTheory = { num_props: n1, axioms: ax1, }
  let th_red : @topos.PropGeoTheory = { num_props: n2, axioms: ax2, }
  let b_x = @topos.build_propositional_classifying_topos(th_x)
  let b_red = @topos.build_propositional_classifying_topos(th_red)
  let pts_x = @topos.enumerate_canonical_points(b_x.site)
  let pts_red = @topos.enumerate_canonical_points(b_red.site)
  // Two Zariski closed points: x = 0 (in D(1-x) \ D(x)) and x = 1 (in D(x) \ D(1-x))!
  if pts_x.length() != 2 || pts_red.length() != 2 {
    return false
  }
  let (dual_f3, _) = @scheme.fcomm_dual_numbers(3)
  let f3 = @scheme.fcomm_fp(3)
  let fp_pts_x = @scheme.eval_affine_functor_of_points(x_aff, f3).length()
  let fp_pts_red = @scheme.eval_affine_functor_of_points(x_red, f3).length()
  let dual_pts_x = @scheme.eval_affine_functor_of_points(x_aff, dual_f3).length()
  let dual_pts_red = @scheme.eval_affine_functor_of_points(x_red, dual_f3).length()
  // Over F_3: both have 2 points ({0, 1}).
  // Over F_3[ε]/(ε^2): X_red has 2 points (0 + 0ε, 1 + 0ε? Wait: (a+bε)(a+bε - 1) = a(a-1) + b(2a-1)ε = 0
  // -> for a=0: -b=0 => b=0 (1 pt); for a=1: b=0 (1 pt) => 2 pts total!!
  // Whereas for X: (a+bε)^2 (a+bε - 1) = (a^2 + 2abε)(a - 1 + bε) = 0
  // -> for a=0: (0)( -1 + bε ) = 0 for ALL b ∈ F_3 (3 pts!!); for a=1: 1 * bε = 0 => b=0 (1 pt) => 4 pts total!!
  fp_pts_x == 2 && fp_pts_red == 2 && dual_pts_x == 4 && dual_pts_red == 2
}

///|
/// Translate an Idempotent Semiring Algebraic Expression `e : @snf.SExpr` into
/// a Propositional Geometric Formula `@topos.GeoFormula` (`SSum -> GOr`, `SProd -> GAnd`)!
pub fn translate_sexpr_to_geo_formula(e : @snf.SExpr) -> @topos.GeoFormula {
  match e {
    SZero => GFalse
    SOne => GTrue
    SVar(v) => GPred(v, [])
    SSum(a, b) =>
      GOr([translate_sexpr_to_geo_formula(a), translate_sexpr_to_geo_formula(b)])
    SProd(a, b) =>
      GAnd(translate_sexpr_to_geo_formula(a), translate_sexpr_to_geo_formula(b))
  }
}

///|
/// **The Quaternary Normal-Form Unification Theorem (`規範形式四位一體`)**:
/// Verifies that distributive/Frobenius algebraic-logical identities simultaneously
/// collapse to **identical canonical normal forms** across ALL FOUR pillars:
///   1. Cubical Cofibration ROBDD (`@cub.bdd_face_eq`),
///   2. Semiring Disjunctive Normalizer (`@snf.normalize`),
///   3. Topos Joyal–Reyes Geometric Normal Form (`@topos.geometric_normal_form`),
///   4. Scheme Buchberger Reduced Gröbner Basis (`@scheme.reduced_groebner_basis`)!
pub fn verify_quaternary_normal_forms() -> Bool {
  // Distributive law `(A ∧ (B ∨ C))` vs `(A ∧ B) ∨ (A ∧ C)`:
  // 1. Cubical Face ROBDD:
  let fa = @cub.face_eq0(@cub.dim_var(0))
  let fb = @cub.face_eq0(@cub.dim_var(1))
  let fc = @cub.face_eq0(@cub.dim_var(2))
  let cub_lhs = @cub.face_and(fa, @cub.face_or(fb, fc))
  let cub_rhs = @cub.face_or(@cub.face_and(fa, fb), @cub.face_and(fa, fc))
  if !@cub.bdd_face_eq(cub_lhs, cub_rhs, 3) {
    return false
  }
  // 2. Semiring NF:
  let sa : @snf.SExpr = SVar(0)
  let sb : @snf.SExpr = SVar(1)
  let sc : @snf.SExpr = SVar(2)
  let s_lhs : @snf.SExpr = SProd(sa, SSum(sb, sc))
  let s_rhs : @snf.SExpr = SSum(SProd(sa, sb), SProd(sa, sc))
  // Note: @snf.SExpr is non-commutative free idempotent semiring where left-distributivity holds!
  if !@snf.idempotent_identity_holds(s_lhs, s_rhs) {
    return false
  }
  // 3. Topos Joyal–Reyes Geometric Frobenius NF (`A ∧ ∃y. (B(y) ∨ C(y))` vs `∃y. (A ∧ B(y)) ∨ ∃y. (A ∧ C(y))`!):
  let frob_lhs : @topos.GeoFormula = GAnd(
    GPred(0, []),
    GExists(GOr([GPred(1, [0]), GPred(2, [0])])),
  )
  let frob_rhs : @topos.GeoFormula = GOr([
    GExists(GAnd(GPred(0, []), GPred(1, [0]))),
    GExists(GAnd(GPred(0, []), GPred(2, [0]))),
  ])
  if @topos.geometric_normal_form(0, frob_lhs) !=
    @topos.geometric_normal_form(0, frob_rhs) {
    return false
  }
  let sierp_cat = @sym.cat_arrow()
  let sierp_site = @topos.site_new(sierp_cat, @topos.topology_trivial(sierp_cat))
  let frob_model : @topos.SheafStructure = {
    carrier: @topos.presheaf_constant_raw(sierp_cat, 2),
    pred_arities: [0, 1, 1],
    relations: [[[[]], []], [[[0]], []], [[[1]], [[1]]]],
  }
  if !@topos.verify_geometric_normal_form_soundness(
      sierp_site, frob_model, 0, frob_lhs,
    ) {
    return false
  }
  // 4. Scheme Reduced Gröbner Basis (`I(cub_lhs) == I(cub_rhs)` in `Q[x_0, x_1, x_2]`!):
  let idl_lhs = translate_cubical_face_to_zariski_ideal(cub_lhs, 3, false)
  let idl_rhs = translate_cubical_face_to_zariski_ideal(cub_rhs, 3, false)
  @scheme.ideal_eq(idl_lhs, idl_rhs)
}

///|
/// **Round-2 Cross-Pillar Bridge I: Diaconescu `Z/2Z`-Torsors ↔ Quadratic Étale
/// Kähler Covers of `G_m` ↔ Galois Frobenius Splitting over `F_3 ⊂ F_9`**:
///   1. Topological/Topos side (`@topos` + `@sym`): `build_mobius_internal_z2_torsor()`
///      is a genuine internal `Z/2Z`-torsor sheaf on `S^1` with `Γ(S^1, T) == 0`;
///   2. Differential-Scheme side (`@scheme`): the double cover `y^2 = x` over `A^1`
///      is ramified (`!is_unramified_ring_hom`), whereas localizing `Ω^1_{B/A}` away
///      from `x = 0` via `localize_quasicoherent_module` kills all differentials
///      (`quasicoherent_module_is_zero == true`) and yields an étale cover of `G_m`;
///   3. Arithmetic-Galois side (`@scheme` + `@exactalg`): `X_0^2 + X_1^2 = 0 ⊆ P^2`
///      has `|Z(F_3)| == 1` under non-split Frobenius action (`[Q(i):Q] == 2`),
///      splitting over `F_9 = fcomm_fp2(3)` to `|Z(F_9)| == 19`!
pub fn verify_quadratic_etale_torsor_galois_bridge() -> Bool {
  // 1. Internal Z/2Z-torsor on S^1:
  let mob_tors = @topos.build_mobius_internal_z2_torsor()
  if !@topos.is_internal_group_torsor_sheaf(mob_tors) {
    return false
  }
  let global_secs = @topos.presheaf_hom_enumerate(
    @topos.presheaf_terminal(mob_tors.site.cat),
    mob_tors.carrier,
  ).length()
  if global_secs != 0 {
    return false
  }
  // 2. Branched double cover `Q[x] -> Q[x, y] / <y^2 - x>` vs localized Étale cover of `G_m`:
  let a1_x = @scheme.coord_ring_new(1, [])
  let dbl_a1 = @scheme.coord_ring_new(2, [
    @scheme.mpoly_sub(
      @scheme.mpoly_pow(@scheme.mpoly_var(2, 1), 2),
      @scheme.mpoly_var(2, 0),
    ),
  ])
  let phi_branched : @scheme.RingHom = {
    src: a1_x,
    dst: dbl_a1,
    var_images: [@scheme.mpoly_var(2, 0)],
  }
  let omega_branched = @scheme.kahler_differentials_module(phi_branched)
  if @scheme.is_unramified_ring_hom(phi_branched) {
    return false
  }
  let omega_on_gm = @scheme.localize_quasicoherent_module(
    omega_branched,
    @scheme.mpoly_var(2, 0),
  )
  if !@scheme.quasicoherent_module_is_zero(omega_on_gm) {
    return false
  }
  // Direct Étale morphism `G_m -> G_m` (`(x, u) -> (x, u, y)` with `u*x = 1, y^2 = x`):
  let gm_base = @scheme.coord_ring_new(2, [
    @scheme.mpoly_sub(
      @scheme.mpoly_mul(@scheme.mpoly_var(2, 0), @scheme.mpoly_var(2, 1)),
      @scheme.mpoly_int(2, 1),
    ),
  ])
  let gm_cover = @scheme.coord_ring_new(3, [
    @scheme.mpoly_sub(
      @scheme.mpoly_mul(@scheme.mpoly_var(3, 0), @scheme.mpoly_var(3, 1)),
      @scheme.mpoly_int(3, 1),
    ),
    @scheme.mpoly_sub(
      @scheme.mpoly_pow(@scheme.mpoly_var(3, 2), 2),
      @scheme.mpoly_var(3, 0),
    ),
  ])
  let phi_etale : @scheme.RingHom = {
    src: gm_base,
    dst: gm_cover,
    var_images: [@scheme.mpoly_var(3, 0), @scheme.mpoly_var(3, 1)],
  }
  if !@scheme.is_etale_ring_hom_between_smooth(phi_etale) {
    return false
  }
  // 3. Galois Frobenius descent over F_3 ⊂ F_9 matching splitting degree [Q(i):Q] == 2:
  @scheme.verify_weil_zeta_and_galois_frobenius_descent()
}

///|
/// **Round-2 Cross-Pillar Bridge II: Open/Closed Subtopos Excision ↔ Blow-Up
/// Strict-Transform Desingularization (`τ = 1, 2 -> 0`)**:
///   1. Topos Co-Heyting Nucleus Excision (`@topos`): on the Sierpinski site,
///      the open subterminal `U = y(0)` violates internal `U ∨ ¬U = ⊤`, YET its
///      open/closed subtoposes partition `PSh(Sierpinski)` (`J_o ∧ J_c = J_triv`,
///      `J_o ∨ J_c = J_inconsistent`)!
///   2. Scheme Rees Blow-Up Excision (`@scheme`): blowing up the closed singular
///      center `(0, 0) ∈ A^2` via Gröbner saturation resolves BOTH the `A_1` node
///      (`τ = 1 -> smooth`) with reduced length-2 exceptional fiber AND the `A_2`
///      cusp (`τ = 2 -> smooth`) with non-reduced length-2 tangent-cone fiber!
pub fn verify_excision_subtopos_blowup_bridge() -> Bool {
  let sierp = @sym.cat_arrow()
  let u_open = @topos.presheaf_representable(sierp, 0)
  let comp_rep = @topos.verify_open_closed_subtopos_complementarity(u_open)
  if !comp_rep.subtopos_boolean_complement_holds || comp_rep.internal_lem_holds {
    return false
  }
  let x = @scheme.mpoly_var(2, 0)
  let y = @scheme.mpoly_var(2, 1)
  let f_node = @scheme.mpoly_sub(
    @scheme.mpoly_pow(y, 2),
    @scheme.mpoly_add(@scheme.mpoly_pow(x, 3), @scheme.mpoly_pow(x, 2)),
  )
  let f_cusp = @scheme.mpoly_sub(
    @scheme.mpoly_pow(y, 2),
    @scheme.mpoly_pow(x, 3),
  )
  let tau_node = @scheme.affine_tjurina_number(
    @scheme.affine_scheme(@scheme.coord_ring_new(2, [f_node])),
  )
  let tau_cusp = @scheme.affine_tjurina_number(
    @scheme.affine_scheme(@scheme.coord_ring_new(2, [f_cusp])),
  )
  let bl_node = @scheme.blowup_plane_curve_at_origin(f_node)
  let bl_cusp = @scheme.blowup_plane_curve_at_origin(f_cusp)
  tau_node == Some(1) &&
  tau_cusp == Some(2) &&
  bl_node.origin_was_singular &&
  bl_node.strict_transform_is_smooth &&
  bl_node.exceptional_fiber_length == 2 &&
  bl_node.exceptional_fiber_is_reduced &&
  bl_cusp.origin_was_singular &&
  bl_cusp.strict_transform_is_smooth &&
  bl_cusp.exceptional_fiber_length == 2 &&
  !bl_cusp.exceptional_fiber_is_reduced
}
