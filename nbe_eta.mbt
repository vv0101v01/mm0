///|
// Typed NbE with η η η: η-long normal forms for functions, products, unit.
//
// The untyped NbE of nbe.mbt decides βπ-equality.  η is type-directed:
//   * functions:  f  ≡η  λx. f x          (η-expand at function type)
//   * products:   p  ≡η  (fst p, snd p)   (η-expand at product type)
//   * unit:       u  ≡η  ()               (every inhabitant is canonical)
// so quote must know the type at every subterm — including inside neutral
// spines, where the argument of a stuck application may itself need
// η-expansion (e.g. f : (B→B)→B expands to λg. f (λx. g x)).  Hence this
// module has its own typed values: neutral applications store the
// argument type, neutral projections store the sibling component type,
// and evaluation is bidirectional (infer / check).  Unannotated λ-heads
// are not inferrable; `TmAnn` provides the annotations, erased by eval.
//
// The resulting normal forms are the canonical representatives of
// morphisms in the free Cartesian closed category generated by Bool and
// Unit (the syntactic category of this fragment): βπ-normal and η-long.
// In particular swap∘swap = id now holds *as functions*, not only on
// closed elements — product η closes the gap noted in the first version.

///|
pub enum LTy {
  LBool
  LUnit
  LProd(LTy, LTy)
  LFun(LTy, LTy)
} derive(Debug, Eq)

///|
pub extend LTy with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend LTy with Eq::{not_equal, equal}

///|
pub enum TNeutral {
  TNeVar(Int32) // level
  TNeApp(TNeutral, TValue, LTy) // stuck app, stores argument type
  TNeFst(TNeutral, LTy) // stuck fst, stores the *snd* type
  TNeSnd(TNeutral, LTy) // stuck snd, stores the *fst* type
}

///|
pub enum TValue {
  TVUnit
  TVBool(Bool)
  TVPair(TValue, TValue)
  TVClosure((TValue) -> TValue)
  TVNeutral(TNeutral)
}

///|
pub struct TypedValue {
  value : TValue
  ty : LTy
}

///|
fn lctx_cons(t : LTy, ctx : Array[LTy]) -> Array[LTy] {
  let out : Array[LTy] = [t]
  for i in 0..<ctx.length() {
    out.push(ctx[i])
  }
  out
}

///|
fn tenv_cons(v : TValue, env : Array[TValue]) -> Array[TValue] {
  let out : Array[TValue] = [v]
  for i in 0..<env.length() {
    out.push(env[i])
  }
  out
}

///|
fn tv_unwrap(v : TValue?) -> TValue {
  match v {
    Some(x) => x
    None => TVUnit // unreachable after ty_check; eval assumes well-typed input
  }
}

///|
pub fn tapp(f : TValue, arg : TValue, arg_ty : LTy) -> TValue {
  match f {
    TVClosure(g) => g(arg)
    TVNeutral(n) => TVNeutral(TNeApp(n, arg, arg_ty))
    _ => TVUnit
  }
}

///|
pub fn tfst(v : TValue, snd_ty : LTy) -> TValue {
  match v {
    TVPair(a, _) => a
    TVNeutral(n) => TVNeutral(TNeFst(n, snd_ty))
    _ => TVUnit
  }
}

///|
pub fn tsnd(v : TValue, fst_ty : LTy) -> TValue {
  match v {
    TVPair(_, b) => b
    TVNeutral(n) => TVNeutral(TNeSnd(n, fst_ty))
    _ => TVUnit
  }
}

// ---------------------------------------------------------------------------
// Bidirectional typing (ctx index 0 = most recent binder, as in eval envs)
// ---------------------------------------------------------------------------

///|
pub fn ty_infer(t : Term, ctx : Array[LTy]) -> LTy? {
  match t {
    TmVar(i) => if i >= 0 && i < ctx.length() { Some(ctx[i]) } else { None }
    TmApp(f, a) =>
      match ty_infer(f, ctx) {
        Some(LFun(dom, cod)) =>
          if ty_check(a, dom, ctx) {
            Some(cod)
          } else {
            None
          }
        _ => None
      }
    TmPair(a, b) =>
      match (ty_infer(a, ctx), ty_infer(b, ctx)) {
        (Some(x), Some(y)) => Some(LProd(x, y))
        _ => None
      }
    TmFst(a) =>
      match ty_infer(a, ctx) {
        Some(LProd(x, _)) => Some(x)
        _ => None
      }
    TmSnd(a) =>
      match ty_infer(a, ctx) {
        Some(LProd(_, y)) => Some(y)
        _ => None
      }
    TmBool(_) => Some(LBool)
    TmUnit => Some(LUnit)
    TmAnn(inner, ty) => if ty_check(inner, ty, ctx) { Some(ty) } else { None }
    TmLam(_) | TmCoeRefl | TmCoeUaSwap => None // check-only forms
  }
}

///|
pub fn ty_check(t : Term, expected : LTy, ctx : Array[LTy]) -> Bool {
  match (t, expected) {
    (TmLam(body), LFun(dom, cod)) => ty_check(body, cod, lctx_cons(dom, ctx))
    (TmPair(a, b), LProd(x, y)) => ty_check(a, x, ctx) && ty_check(b, y, ctx)
    (TmCoeRefl, LFun(a, b)) => a == b
    (TmCoeUaSwap, LFun(LProd(a, b), LProd(c, d))) => a == d && b == c
    _ =>
      match ty_infer(t, ctx) {
        Some(ty) => ty == expected
        None => false
      }
  }
}

// ---------------------------------------------------------------------------
// Bidirectional evaluation (assumes ty_check / ty_infer succeeded)
// ---------------------------------------------------------------------------

///|
pub fn eval_infer_t(
  t : Term,
  ctx : Array[LTy],
  env : Array[TValue],
) -> TypedValue? {
  match t {
    TmVar(i) =>
      if i >= 0 && i < ctx.length() {
        Some(TypedValue::{ value: env[i], ty: ctx[i], })
      } else {
        None
      }
    TmApp(f, a) =>
      match eval_infer_t(f, ctx, env) {
        Some(fv) =>
          match fv.ty {
            LFun(dom, cod) =>
              match eval_check_t(a, dom, ctx, env) {
                Some(av) =>
                  Some(TypedValue::{ value: tapp(fv.value, av, dom), ty: cod, })
                None => None
              }
            _ => None
          }
        None => None
      }
    TmPair(a, b) =>
      match (eval_infer_t(a, ctx, env), eval_infer_t(b, ctx, env)) {
        (Some(x), Some(y)) =>
          Some(TypedValue::{
            value: TVPair(x.value, y.value),
            ty: LProd(x.ty, y.ty),
          })
        _ => None
      }
    TmFst(a) =>
      match eval_infer_t(a, ctx, env) {
        Some(v) =>
          match v.ty {
            LProd(x, y) => Some(TypedValue::{ value: tfst(v.value, y), ty: x, })
            _ => None
          }
        None => None
      }
    TmSnd(a) =>
      match eval_infer_t(a, ctx, env) {
        Some(v) =>
          match v.ty {
            LProd(x, y) => Some(TypedValue::{ value: tsnd(v.value, x), ty: y, })
            _ => None
          }
        None => None
      }
    TmBool(b) => Some(TypedValue::{ value: TVBool(b), ty: LBool, })
    TmUnit => Some(TypedValue::{ value: TVUnit, ty: LUnit, })
    TmAnn(inner, ty) =>
      match eval_check_t(inner, ty, ctx, env) {
        Some(v) => Some(TypedValue::{ value: v, ty, })
        None => None
      }
    TmLam(_) | TmCoeRefl | TmCoeUaSwap => None
  }
}

///|
pub fn eval_check_t(
  t : Term,
  expected : LTy,
  ctx : Array[LTy],
  env : Array[TValue],
) -> TValue? {
  match (t, expected) {
    (TmLam(body), LFun(dom, cod)) =>
      Some(
        TVClosure(arg => {
          tv_unwrap(
            eval_check_t(body, cod, lctx_cons(dom, ctx), tenv_cons(arg, env)),
          )
        }),
      )
    (TmPair(a, b), LProd(x, y)) =>
      match (eval_check_t(a, x, ctx, env), eval_check_t(b, y, ctx, env)) {
        (Some(av), Some(bv)) => Some(TVPair(av, bv))
        _ => None
      }
    (TmCoeRefl, LFun(a, b)) =>
      if a == b {
        Some(TVClosure(v => v))
      } else {
        None
      }
    (TmCoeUaSwap, LFun(LProd(a, b), LProd(_, _))) =>
      Some(TVClosure(p => TVPair(tsnd(p, a), tfst(p, b))))
    _ =>
      match eval_infer_t(t, ctx, env) {
        Some(v) => if v.ty == expected { Some(v.value) } else { None }
        None => None
      }
  }
}

// ---------------------------------------------------------------------------
// Type-directed quoting: η-long normal forms
// ---------------------------------------------------------------------------

///|
pub fn quote_tneutral(level : Int32, n : TNeutral, ty : LTy) -> Term {
  match n {
    TNeVar(l) => TmVar(level - 1 - l)
    TNeApp(f, arg, arg_ty) =>
      TmApp(
        quote_tneutral(level, f, LFun(arg_ty, ty)),
        quote_eta(level, arg_ty, arg),
      )
    TNeFst(inner, snd_ty) =>
      TmFst(quote_tneutral(level, inner, LProd(ty, snd_ty)))
    TNeSnd(inner, fst_ty) =>
      TmSnd(quote_tneutral(level, inner, LProd(fst_ty, ty)))
  }
}

///|
pub fn quote_eta(level : Int32, ty : LTy, v : TValue) -> Term {
  match ty {
    LUnit => TmUnit // unit η: everything is canonical
    LBool =>
      match v {
        TVBool(b) => TmBool(b)
        TVNeutral(n) => quote_tneutral(level, n, LBool)
        _ => TmUnit
      }
    LFun(a, b) =>
      TmLam(quote_eta(level + 1, b, tapp(v, TVNeutral(TNeVar(level)), a)))
    LProd(a, b) =>
      TmPair(quote_eta(level, a, tfst(v, b)), quote_eta(level, b, tsnd(v, a)))
  }
}

///|
fn fresh_tenv(nfree : Int32) -> Array[TValue] {
  let env : Array[TValue] = []
  for i in 0..<nfree {
    env.push(TVNeutral(TNeVar(nfree - 1 - i)))
  }
  env
}

///|
/// η-long βπ-normal form, or None if the term is ill-typed at `ty` in `ctx`
/// (ctx index 0 = most recent binder).
pub fn nf_eta(t : Term, ty : LTy, ctx : Array[LTy]) -> Term? {
  if !ty_check(t, ty, ctx) {
    return None
  }
  match eval_check_t(t, ty, ctx, fresh_tenv(ctx.length())) {
    Some(v) => Some(quote_eta(ctx.length(), ty, v))
    None => None
  }
}

///|
/// Definitional equality up to βπη and the coe rules, decided by η-NbE.
pub fn def_eq_eta(t : Term, u : Term, ty : LTy, ctx : Array[LTy]) -> Bool {
  match (nf_eta(t, ty, ctx), nf_eta(u, ty, ctx)) {
    (Some(a), Some(b)) => a == b
    _ => false
  }
}

///|
pub fn eta_single_valued_on(t : Term, ty : LTy, ctx : Array[LTy]) -> Bool {
  match nf_eta(t, ty, ctx) {
    Some(n1) =>
      match nf_eta(n1, ty, ctx) {
        Some(n2) => n1 == n2
        None => false
      }
    None => false
  }
}

///|
/// swap, annotated at A×B → B×A so it is inferrable.
pub fn tm_swap_at(a : LTy, b : LTy) -> Term {
  TmAnn(tm_swap(), LFun(LProd(a, b), LProd(b, a)))
}

///|
/// ua(swap) coe, annotated at A×B → B×A.
pub fn tm_coe_swap_at(a : LTy, b : LTy) -> Term {
  TmAnn(TmCoeUaSwap, LFun(LProd(a, b), LProd(b, a)))
}

// ---------------------------------------------------------------------------
// The η laws and their payoff
// ---------------------------------------------------------------------------

///|
pub fn check_eta_function() -> Bool {
  let ctx : Array[LTy] = [LFun(LBool, LBool)]
  let ty = LFun(LBool, LBool)
  let eta_expanded = TmLam(TmApp(TmVar(1), TmVar(0)))
  def_eq_eta(TmVar(0), eta_expanded, ty, ctx) &&
  nf_eta(TmVar(0), ty, ctx) == Some(eta_expanded) &&
  eta_single_valued_on(TmVar(0), ty, ctx)
}

///|
pub fn check_eta_product() -> Bool {
  let ty = LProd(LBool, LUnit)
  let ctx : Array[LTy] = [ty]
  let eta_expanded = TmPair(TmFst(TmVar(0)), TmUnit) // snd component unit-η-collapses
  def_eq_eta(TmVar(0), TmPair(TmFst(TmVar(0)), TmSnd(TmVar(0))), ty, ctx) &&
  nf_eta(TmVar(0), ty, ctx) == Some(eta_expanded)
}

///|
pub fn check_eta_unit() -> Bool {
  let ctx : Array[LTy] = [LUnit]
  def_eq_eta(TmVar(0), TmUnit, LUnit, ctx)
}

///|
pub fn check_eta_spine() -> Bool {
  // f : (B→B)→B must η-expand to λg. f (λx. g x): η inside a neutral spine.
  let ty = LFun(LFun(LBool, LBool), LBool)
  let ctx : Array[LTy] = [ty]
  let expected = TmLam(TmApp(TmVar(1), TmLam(TmApp(TmVar(1), TmVar(0)))))
  nf_eta(TmVar(0), ty, ctx) == Some(expected) &&
  eta_single_valued_on(TmVar(0), ty, ctx)
}

///|
pub fn check_eta_swap_involution() -> Bool {
  // With product η, swap∘swap is *definitionally* the identity function.
  let ty = LFun(LProd(LBool, LUnit), LProd(LBool, LUnit))
  let double_swap = TmLam(
    TmApp(tm_swap_at(LUnit, LBool), TmApp(tm_swap_at(LBool, LUnit), TmVar(0))),
  )
  let double_coe = TmLam(
    TmApp(
      tm_coe_swap_at(LUnit, LBool),
      TmApp(tm_coe_swap_at(LBool, LUnit), TmVar(0)),
    ),
  )
  let ctx : Array[LTy] = []
  def_eq_eta(double_swap, tm_id(), ty, ctx) &&
  def_eq_eta(double_coe, TmCoeRefl, ty, ctx) &&
  nf_eta(double_swap, ty, ctx) == nf_eta(tm_id(), ty, ctx)
}

///|
pub fn check_eta_all() -> Bool {
  check_eta_function() &&
  check_eta_product() &&
  check_eta_unit() &&
  check_eta_spine() &&
  check_eta_swap_involution() &&
  // ill-typed input is rejected, not normalised
  nf_eta(TmApp(TmBool(true), TmUnit), LBool, []) == None
}

// ---------------------------------------------------------------------------
// Syntactic category structure on closed function terms
// ---------------------------------------------------------------------------

///|
/// Shift free de Bruijn indices at or above `cutoff` up by `by_`.
pub fn tm_shift(t : Term, by_ : Int32, cutoff : Int32) -> Term {
  match t {
    TmVar(i) => if i >= cutoff { TmVar(i + by_) } else { TmVar(i) }
    TmLam(b) => TmLam(tm_shift(b, by_, cutoff + 1))
    TmApp(f, a) => TmApp(tm_shift(f, by_, cutoff), tm_shift(a, by_, cutoff))
    TmPair(a, b) => TmPair(tm_shift(a, by_, cutoff), tm_shift(b, by_, cutoff))
    TmFst(a) => TmFst(tm_shift(a, by_, cutoff))
    TmSnd(a) => TmSnd(tm_shift(a, by_, cutoff))
    TmAnn(inner, ty) => TmAnn(tm_shift(inner, by_, cutoff), ty)
    TmBool(_) | TmUnit | TmCoeRefl | TmCoeUaSwap => t
  }
}

///|
/// Composition of closed arrows in the syntactic (Cartesian closed)
/// category: comp f g = λx. f (g x).
pub fn tm_comp_closed(f : Term, g : Term) -> Term {
  TmLam(TmApp(tm_shift(f, 1, 0), TmApp(tm_shift(g, 1, 0), TmVar(0))))
}

///|
/// The identity arrow at a type, annotated.
pub fn tm_id_at(a : LTy) -> Term {
  TmAnn(tm_id(), LFun(a, a))
}

///|
/// Composition as a *typed arrow* A→C from g : A→B and f : B→C,
/// annotated so that iterated compositions remain inferrable.
pub fn tm_comp_at(f : Term, g : Term, a : LTy, b : LTy, c : LTy) -> Term {
  let _ = b
  TmAnn(tm_comp_closed(f, g), LFun(a, c))
}
