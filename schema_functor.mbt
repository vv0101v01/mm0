///|
// Strictly positive functor descriptors, constructor constraints, and
// induction-recursive decoding for generated inductive families.
//
// A `DPositiveFunctor` is a finite syntax for the strictly positive
// endofunctors generated by identity, external constants, products,
// sums, lists, Pi over an external domain, and dependent polynomial
// containers.  Containers subsume the usual strictly positive
// polynomial presentations.  The three operations
// below generate, uniformly in the descriptor:
//
//   * the semantic type `F X`;
//   * the induction-hypothesis type `All_F P x`; and
//   * the map which constructs an element of that All-type by
//     applying the eliminator at every recursive occurrence.
//
// Constructor constraints are propositional Path side conditions.
// They are checked at introductions and are passed as final Path
// arguments to generated eliminator cases.
//
// If an inductive spec has decode cases, its constructors are codes
// and `eval_inductive_decode` is the simultaneously defined decoding
// function.  Neutral codes decode to a dedicated neutral type, so a
// decoded domain remains available under binders.

///|
pub fn schema_value_prefix(values : Array[DValue], n : Int32) -> Array[DValue] {
  let out : Array[DValue] = []
  for i in 0..<n {
    if i < values.length() {
      out.push(values[i])
    }
  }
  out
}

///|
pub fn schema_arg_spec_prefix(
  args : Array[DConstructorArg],
  n : Int32,
) -> Array[DConstructorArg] {
  let out : Array[DConstructorArg] = []
  for i in 0..<n {
    if i < args.length() {
      out.push(args[i])
    }
  }
  out
}

///|
fn schema_source_indices(
  arg : DConstructorArg,
  prior_specs : Array[DConstructorArg],
  params : Array[DValue],
  prior : Array[DValue],
) -> Array[DValue] {
  if arg.target < 0 || arg.target >= prior_specs.length() {
    []
  } else {
    let source = prior_specs[arg.target]
    match source.kind {
      DArgRecursive =>
        schema_eval_index_terms(
          params,
          schema_value_prefix(prior, arg.target),
          source.index,
        )
      _ => []
    }
  }
}

///|
fn schema_source_value(arg : DConstructorArg, prior : Array[DValue]) -> DValue {
  if arg.target >= 0 && arg.target < prior.length() {
    prior[arg.target]
  } else {
    DVUnit
  }
}

///|
fn semantic_type_universe_level(ty : DValue) -> Int32 {
  match force_value(ty) {
    DVInductive(spec, _, _) => spec.level
    DVHitType(spec, _, _) => spec.level
    DVUniv(l) => l + 1
    DVListTy(elem) => semantic_type_universe_level(elem)
    DVEquivTy(_, _, l) | DVGlue(_, _, l) => l
    _ => 0
  }
}

///|
fn positive_sum_family(a : DValue, b : DValue) -> (DValue) -> DValue {
  let la = semantic_type_universe_level(a)
  let lb = semantic_type_universe_level(b)
  let level = if la >= lb { la } else { lb }
  tag => {
    match force_value(tag) {
      DVBool(true) => a
      DVBool(false) => b
      DVNeutral(n) => DVNeutral(DNBoolElim(_ => DVUniv(level), a, b, n))
      _ => DVUnitTy
    }
  }
}

///|
/// Recover the host inductive spec from the ambient `family`
/// callback, which by convention returns the host type at the
/// ambient parameters and the given indices.  `None` in
/// non-inductive (HIT or dummy) contexts, where the self-family
/// node is not supported.
fn self_family_spec_of(
  family : (Array[DValue]) -> DValue,
  index_values : Array[DValue],
) -> DInductiveSpec? {
  match force_value(family(index_values)) {
    DVInductive(spec, _, _) => Some(spec)
    _ => None
  }
}

///|
/// The host family type at a changed parameter instantiation.
fn self_family_type_at(
  family : (Array[DValue]) -> DValue,
  param_values : Array[DValue],
  index_values : Array[DValue],
) -> DValue {
  match self_family_spec_of(family, index_values) {
    Some(spec) => DVInductive(spec, param_values, index_values)
    None => family(index_values)
  }
}

///|
/// The semantic type obtained by applying a positive functor to an
/// indexed family.
pub fn positive_functor_type(
  functor : DPositiveFunctor,
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
) -> DValue {
  match functor {
    DFunctorIdentity(index) =>
      family(schema_eval_index_terms(params, prior, index))
    DFunctorConst(ty) =>
      schema_eval_under(ty, schema_concat_values(params, prior), [])
    DFunctorProduct(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      DVSigma(ta, _ => tb)
    }
    DFunctorSum(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      DVSigma(DVBoolTy, positive_sum_family(ta, tb))
    }
    DFunctorList(inner) =>
      DVListTy(positive_functor_type(inner, params, prior, family))
    DFunctorContainer(shape, positions, index) => {
      let shape_ty = schema_eval_under(
        shape,
        schema_concat_values(params, prior),
        [],
      )
      DVSigma(shape_ty, s => {
        let prior_s = schema_concat_values(prior, [s])
        let pos_ty = schema_eval_under(
          positions,
          schema_concat_values(params, prior_s),
          [],
        )
        DVPi(pos_ty, p => {
          family(
            schema_eval_index_terms(
              params,
              schema_concat_values(prior_s, [p]),
              index,
            ),
          )
        })
      })
    }
    DFunctorPi(dom, inner) => {
      let dv = schema_eval_under(dom, schema_concat_values(params, prior), [])
      DVPi(dv, a => {
        positive_functor_type(
          inner,
          params,
          schema_concat_values(prior, [a]),
          family,
        )
      })
    }
    DFunctorSigma(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      DVSigma(ta, v => {
        positive_functor_type(
          b,
          params,
          schema_concat_values(prior, [v]),
          family,
        )
      })
    }
    DFunctorFamily(spec, pargs, index) => {
      let (param_values, _, index_values) = family_instantiate(
        pargs,
        index,
        params,
        prior,
        js => family(js),
        _ => family_dummy_handler(),
        [],
      )
      DVInductive(spec, param_values, index_values)
    }
    DFunctorSelfFamily(pargs, index) => {
      let (param_values, _, index_values) = family_instantiate(
        pargs,
        index,
        params,
        prior,
        js => family(js),
        _ => family_dummy_handler(),
        [],
      )
      self_family_type_at(family, param_values, index_values)
    }
  }
}

///|
/// Universe level at which this family's induction-hypothesis
/// bundle *types* live.  A bundle type is built by recursion
/// over the stored value (list spines, sum tags), so the
/// recursion needs a codomain universe: with the kernel's
/// motive discipline (motives land in `Type_{spec.level}`)
/// every bundle type is an element of `Type_{spec.level}` --
/// Sigma over leaves in `Type_{spec.level}` cannot escape it,
/// since no leaf can be `Type_{spec.level}` itself.  Recording
/// a smaller universe (as a bare `Type_0`) is level-dishonest:
/// it is invisible while everything stays semantic, but a
/// quoted bundle-type term then fails to check against its
/// own semantics, because Sigma over a `Type_l` leaf lives in
/// `Type_{l+1}`.  Read off the family head where possible.
fn functor_bundle_universe(family : (Array[DValue]) -> DValue) -> Int32 {
  match force_value(family([])) {
    DVInductive(spec, _, _) => spec.level
    DVHitType(spec, _, _) => spec.level
    _ => 0
  }
}

///|
/// The type of eliminator results at all recursive occurrences in a
/// value of `F X`.  Constants contribute Unit; lists contribute the
/// dependent All-type, represented recursively by nested Sigmas.
pub fn positive_functor_ih_type(
  functor : DPositiveFunctor,
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
  motive : (Array[DValue], DValue) -> DValue,
  value : DValue,
) -> DValue {
  match functor {
    DFunctorIdentity(index) =>
      motive(schema_eval_index_terms(params, prior, index), value)
    DFunctorConst(_) => DVUnitTy
    DFunctorProduct(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let x = dfst_typed(value, _ => tb)
      let y = dsnd_typed(value, ta, _ => tb)
      DVSigma(positive_functor_ih_type(a, params, prior, family, motive, x), _ => {
        positive_functor_ih_type(b, params, prior, family, motive, y)
      })
    }
    DFunctorSum(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let fam = positive_sum_family(ta, tb)
      let tag = dfst_typed(value, fam)
      let payload = dsnd_typed(value, DVBoolTy, fam)
      match force_value(tag) {
        DVBool(true) =>
          positive_functor_ih_type(a, params, prior, family, motive, payload)
        DVBool(false) =>
          positive_functor_ih_type(b, params, prior, family, motive, payload)
        _ =>
          eval_bool_elim(
            _ => DVUniv(functor_bundle_universe(family)),
            positive_functor_ih_type(a, params, prior, family, motive, payload),
            positive_functor_ih_type(b, params, prior, family, motive, payload),
            tag,
            0,
          )
      }
    }
    DFunctorList(inner) => {
      let elem = positive_functor_type(inner, params, prior, family)
      let step : DValue = DVLam(x => {
        DVLam(_xs => {
          DVLam(ih => {
            DVSigma(
              positive_functor_ih_type(inner, params, prior, family, motive, x),
              _ => ih,
            )
          })
        })
      })
      eval_list_elim(
        elem,
        _ => DVUniv(functor_bundle_universe(family)),
        DVUnitTy,
        step,
        value,
        0,
      )
    }
    DFunctorContainer(shape, positions, index) => {
      let shape_ty = schema_eval_under(
        shape,
        schema_concat_values(params, prior),
        [],
      )
      let branch : (DValue) -> DValue = s => {
        let prior_s = schema_concat_values(prior, [s])
        let pos_ty = schema_eval_under(
          positions,
          schema_concat_values(params, prior_s),
          [],
        )
        DVPi(pos_ty, p => {
          family(
            schema_eval_index_terms(
              params,
              schema_concat_values(prior_s, [p]),
              index,
            ),
          )
        })
      }
      let s = dfst_typed(value, branch)
      let contents = dsnd_typed(value, shape_ty, branch)
      let prior_s = schema_concat_values(prior, [s])
      let pos_ty = schema_eval_under(
        positions,
        schema_concat_values(params, prior_s),
        [],
      )
      DVPi(pos_ty, p => {
        motive(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior_s, [p]),
            index,
          ),
          dapp_typed(contents, p, pos_ty),
        )
      })
    }
    DFunctorPi(dom, inner) => {
      let dv = schema_eval_under(dom, schema_concat_values(params, prior), [])
      DVPi(dv, a => {
        positive_functor_ih_type(
          inner,
          params,
          schema_concat_values(prior, [a]),
          family,
          motive,
          dapp_typed(value, a, dv),
        )
      })
    }
    DFunctorSigma(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb_family : (DValue) -> DValue = v => {
        positive_functor_type(
          b,
          params,
          schema_concat_values(prior, [v]),
          family,
        )
      }
      let x = dfst_typed(value, tb_family)
      let y = dsnd_typed(value, ta, tb_family)
      DVSigma(positive_functor_ih_type(a, params, prior, family, motive, x), _ => {
        positive_functor_ih_type(
          b,
          params,
          schema_concat_values(prior, [x]),
          family,
          motive,
          y,
        )
      })
    }
    DFunctorFamily(spec, pargs, index) => {
      let (param_values, handlers, index_values) = family_instantiate(
        pargs,
        index,
        params,
        prior,
        js => family(js),
        js => { type_of: y => motive(js, y), map_of: _ => DVUnit, },
        [],
      )
      family_gather_type(spec, param_values, handlers, index_values, value)
    }
    DFunctorSelfFamily(pargs, index) => {
      let (param_values, handlers, index_values) = family_instantiate(
        pargs,
        index,
        params,
        prior,
        js => family(js),
        js => { type_of: y => motive(js, y), map_of: _ => DVUnit, },
        [],
      )
      match self_family_spec_of(family, index_values) {
        Some(spec) =>
          family_gather_type(spec, param_values, handlers, index_values, value)
        None => DVUnitTy
      }
    }
  }
}

///|
/// Apply an eliminator at every recursive occurrence, producing a
/// value of `positive_functor_ih_type`.
pub fn positive_functor_map(
  functor : DPositiveFunctor,
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
  motive : (Array[DValue], DValue) -> DValue,
  elim : (Array[DValue], DValue) -> DValue,
  value : DValue,
) -> DValue {
  match functor {
    DFunctorIdentity(index) =>
      elim(schema_eval_index_terms(params, prior, index), value)
    DFunctorConst(_) => DVUnit
    DFunctorProduct(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let x = dfst_typed(value, _ => tb)
      let y = dsnd_typed(value, ta, _ => tb)
      DVPair(
        positive_functor_map(a, params, prior, family, motive, elim, x),
        positive_functor_map(b, params, prior, family, motive, elim, y),
      )
    }
    DFunctorSum(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let fam = positive_sum_family(ta, tb)
      let tag = dfst_typed(value, fam)
      let payload = dsnd_typed(value, DVBoolTy, fam)
      match force_value(tag) {
        DVBool(true) =>
          positive_functor_map(a, params, prior, family, motive, elim, payload)
        DVBool(false) =>
          positive_functor_map(b, params, prior, family, motive, elim, payload)
        _ =>
          eval_bool_elim(
            t => {
              positive_functor_ih_type(
                DFunctorSum(a, b),
                params,
                prior,
                family,
                motive,
                DVPair(t, payload),
              )
            },
            positive_functor_map(
              a, params, prior, family, motive, elim, payload,
            ),
            positive_functor_map(
              b, params, prior, family, motive, elim, payload,
            ),
            tag,
            0,
          )
      }
    }
    DFunctorList(inner) => {
      let elem = positive_functor_type(inner, params, prior, family)
      let step : DValue = DVLam(x => {
        DVLam(_xs => {
          DVLam(ih => {
            DVPair(
              positive_functor_map(
                inner, params, prior, family, motive, elim, x,
              ),
              ih,
            )
          })
        })
      })
      eval_list_elim(
        elem,
        xs => {
          positive_functor_ih_type(
            DFunctorList(inner),
            params,
            prior,
            family,
            motive,
            xs,
          )
        },
        DVUnit,
        step,
        value,
        0,
      )
    }
    DFunctorContainer(shape, positions, index) => {
      let shape_ty = schema_eval_under(
        shape,
        schema_concat_values(params, prior),
        [],
      )
      let branch : (DValue) -> DValue = s => {
        let prior_s = schema_concat_values(prior, [s])
        let pos_ty = schema_eval_under(
          positions,
          schema_concat_values(params, prior_s),
          [],
        )
        DVPi(pos_ty, p => {
          family(
            schema_eval_index_terms(
              params,
              schema_concat_values(prior_s, [p]),
              index,
            ),
          )
        })
      }
      let s = dfst_typed(value, branch)
      let contents = dsnd_typed(value, shape_ty, branch)
      let prior_s = schema_concat_values(prior, [s])
      let pos_ty = schema_eval_under(
        positions,
        schema_concat_values(params, prior_s),
        [],
      )
      DVLam(p => {
        elim(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior_s, [p]),
            index,
          ),
          dapp_typed(contents, p, pos_ty),
        )
      })
    }
    DFunctorPi(dom, inner) => {
      let dv = schema_eval_under(dom, schema_concat_values(params, prior), [])
      DVLam(a => {
        positive_functor_map(
          inner,
          params,
          schema_concat_values(prior, [a]),
          family,
          motive,
          elim,
          dapp_typed(value, a, dv),
        )
      })
    }
    DFunctorSigma(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb_family : (DValue) -> DValue = v => {
        positive_functor_type(
          b,
          params,
          schema_concat_values(prior, [v]),
          family,
        )
      }
      let x = dfst_typed(value, tb_family)
      let y = dsnd_typed(value, ta, tb_family)
      DVPair(
        positive_functor_map(a, params, prior, family, motive, elim, x),
        positive_functor_map(
          b,
          params,
          schema_concat_values(prior, [x]),
          family,
          motive,
          elim,
          y,
        ),
      )
    }
    DFunctorFamily(spec, pargs, index) => {
      let (param_values, handlers, index_values) = family_instantiate(
        pargs,
        index,
        params,
        prior,
        js => family(js),
        js => { type_of: y => motive(js, y), map_of: y => elim(js, y), },
        [],
      )
      family_gather_map(spec, param_values, handlers, index_values, value)
    }
    DFunctorSelfFamily(pargs, index) => {
      let (param_values, handlers, index_values) = family_instantiate(
        pargs,
        index,
        params,
        prior,
        js => family(js),
        js => { type_of: y => motive(js, y), map_of: y => elim(js, y), },
        [],
      )
      match self_family_spec_of(family, index_values) {
        Some(spec) =>
          family_gather_map(spec, param_values, handlers, index_values, value)
        None => DVUnit
      }
    }
  }
}

///|
/// How induction hypotheses are gathered for elements stored at
/// one parameter of a family applied by `DFunctorFamily`:
/// `type_of` is the collection type for one stored element,
/// `map_of` produces the collection.  For a `Self` argument these
/// are the ambient motive and eliminator; for a parameter passed
/// through from an enclosing family they are that family's
/// handler; for the elements of the family currently being
/// eliminated they are `family_gather_type`/`family_gather_map`
/// themselves.
priv struct DFamilyParamHandler {
  type_of : (DValue) -> DValue
  map_of : (DValue) -> DValue
}

///|
fn family_dummy_handler() -> DFamilyParamHandler {
  { type_of: _ => DVUnitTy, map_of: _ => DVUnit, }
}

///|
/// When `ty` is exactly the variable for a handled parameter in a
/// context of length `ctx_len` (parameters at the front), the
/// handler for values at that leaf.
fn family_self_leaf(
  handlers : Array[DFamilyParamHandler?],
  ctx_len : Int32,
  ty : DTerm,
) -> DFamilyParamHandler? {
  match ty {
    DTVar(v) => {
      let pos = ctx_len - 1 - v
      if pos >= 0 && pos < handlers.length() {
        handlers[pos]
      } else {
        None
      }
    }
    _ => None
  }
}

///|
/// Whether `t` mentions any parameter with a gather handler, in
/// a context of length `ctx_len` whose first entries are the
/// handled parameters.
fn family_term_mentions_handled(
  handlers : Array[DFamilyParamHandler?],
  ctx_len : Int32,
  t : DTerm,
) -> Bool {
  for pos in 0..<handlers.length() {
    match handlers[pos] {
      Some(_) => if dterm_free_var_occurs(t, ctx_len - 1 - pos) { return true }
      None => ()
    }
  }
  false
}

///|
/// Gather induction hypotheses through an ordinary *type term*
/// shape, not just through a whole parameter variable.  The
/// supported shapes are parameter leaves, lists, dependent
/// pairs, functions (handled parameters in the codomain; domain
/// occurrences are rejected by the gatherability scan), and
/// applications of declared inductive families whose parameter
/// arguments are themselves supported shapes.  `values` is the
/// semantic context in which `ty` is read.  A shape mentioning
/// no handled parameter contributes Unit.
fn family_gather_term_shape(
  handlers : Array[DFamilyParamHandler?],
  values : Array[DValue],
  ty : DTerm,
  value : DValue,
  want_type : Bool,
) -> DValue {
  if !family_term_mentions_handled(handlers, values.length(), ty) {
    return if want_type { DVUnitTy } else { DVUnit }
  }
  match ty {
    DTVar(_) =>
      match family_self_leaf(handlers, values.length(), ty) {
        Some(h) =>
          if want_type {
            (h.type_of)(value)
          } else {
            (h.map_of)(value)
          }
        None => if want_type { DVUnitTy } else { DVUnit }
      }
    DListTy(inner) => {
      let elem_ty = schema_eval_under(inner, values, [])
      if want_type {
        let step : DValue = DVLam(x => {
          DVLam(_xs => {
            DVLam(ih => {
              DVSigma(
                family_gather_term_shape(handlers, values, inner, x, true),
                _ => ih,
              )
            })
          })
        })
        eval_list_elim(elem_ty, _ => DVUniv(0), DVUnitTy, step, value, 0)
      } else {
        let step : DValue = DVLam(x => {
          DVLam(_xs => {
            DVLam(ih => {
              DVPair(
                family_gather_term_shape(handlers, values, inner, x, false),
                ih,
              )
            })
          })
        })
        eval_list_elim(
          elem_ty,
          xs => family_gather_term_shape(handlers, values, ty, xs, true),
          DVUnit,
          step,
          value,
          0,
        )
      }
    }
    DSigma(a, b) => {
      let ta = schema_eval_under(a, values, [])
      let fam : (DValue) -> DValue = v => {
        schema_eval_under(b, schema_concat_values(values, [v]), [])
      }
      let x = dfst_typed(value, fam)
      let y = dsnd_typed(value, ta, fam)
      let gx = family_gather_term_shape(handlers, values, a, x, want_type)
      let gy = family_gather_term_shape(
        handlers,
        schema_concat_values(values, [x]),
        b,
        y,
        want_type,
      )
      if want_type {
        DVSigma(gx, _ => gy)
      } else {
        DVPair(gx, gy)
      }
    }
    DPi(dom, cod) => {
      let dv = schema_eval_under(dom, values, [])
      if want_type {
        DVPi(dv, a => {
          family_gather_term_shape(
            handlers,
            schema_concat_values(values, [a]),
            cod,
            dapp_typed(value, a, dv),
            true,
          )
        })
      } else {
        DVLam(a => {
          family_gather_term_shape(
            handlers,
            schema_concat_values(values, [a]),
            cod,
            dapp_typed(value, a, dv),
            false,
          )
        })
      }
    }
    DInductive(spec2, args) => {
      if args.length() < spec2.params.length() + spec2.indices.length() {
        return if want_type { DVUnitTy } else { DVUnit }
      }
      let mut relevant = false
      for k in 0..<spec2.params.length() {
        if family_term_mentions_handled(handlers, values.length(), args[k]) {
          relevant = true
        }
      }
      if !relevant {
        return if want_type { DVUnitTy } else { DVUnit }
      }
      let param_values2 : Array[DValue] = []
      let handlers2 : Array[DFamilyParamHandler?] = []
      for k in 0..<spec2.params.length() {
        param_values2.push(schema_eval_under(args[k], values, []))
        handlers2.push(family_shape_handler(handlers, values, args[k]))
      }
      let index_values2 : Array[DValue] = []
      for k in spec2.params.length()..<args.length() {
        index_values2.push(schema_eval_under(args[k], values, []))
      }
      if want_type {
        family_gather_type(
          spec2, param_values2, handlers2, index_values2, value,
        )
      } else {
        family_gather_map(spec2, param_values2, handlers2, index_values2, value)
      }
    }
    _ => if want_type { DVUnitTy } else { DVUnit }
  }
}

///|
/// The handler for elements stored at a parameter instantiated
/// by the type term `t`: the leaf handler when `t` is exactly a
/// handled parameter, a synthesized shape handler when `t`
/// mentions handled parameters in a supported shape, and `None`
/// when it mentions none.
fn family_shape_handler(
  handlers : Array[DFamilyParamHandler?],
  values : Array[DValue],
  t : DTerm,
) -> DFamilyParamHandler? {
  match family_self_leaf(handlers, values.length(), t) {
    Some(h) => Some(h)
    None =>
      if family_term_mentions_handled(handlers, values.length(), t) {
        Some({
          type_of: y => family_gather_term_shape(handlers, values, t, y, true),
          map_of: y => family_gather_term_shape(handlers, values, t, y, false),
        })
      } else {
        None
      }
  }
}

///|
/// Instantiate a `DFunctorFamily` node's parameter arguments in
/// the context `params ++ prior`.  `self_type` builds the type
/// denoted by a `Self` argument from its evaluated indices and
/// `self_handler` its IH handler; `outer_handlers` are the
/// handlers of the enclosing family's parameters, used when a
/// `Term` argument is exactly one of those parameter variables
/// (pass-through).
fn family_instantiate(
  pargs : Array[DFunctorParamArg],
  index : Array[DTerm],
  params : Array[DValue],
  prior : Array[DValue],
  self_type : (Array[DValue]) -> DValue,
  self_handler : (Array[DValue]) -> DFamilyParamHandler,
  outer_handlers : Array[DFamilyParamHandler?],
) -> (Array[DValue], Array[DFamilyParamHandler?], Array[DValue]) {
  let param_values : Array[DValue] = []
  let handlers : Array[DFamilyParamHandler?] = []
  for i in 0..<pargs.length() {
    match pargs[i] {
      DFunctorParamSelf(js) => {
        let jsv = schema_eval_index_terms(params, prior, js)
        param_values.push(self_type(jsv))
        handlers.push(Some(self_handler(jsv)))
      }
      DFunctorParamTerm(t) => {
        let values = schema_concat_values(params, prior)
        param_values.push(schema_eval_under(t, values, []))
        handlers.push(family_shape_handler(outer_handlers, values, t))
      }
    }
  }
  (param_values, handlers, schema_eval_index_terms(params, prior, index))
}

///|
/// The type of the bundle of induction hypotheses for all
/// host-recursive occurrences inside one element of an applied
/// family.  It is computed by eliminating the element into the
/// universe: each constructor contributes a Sigma of the bundles
/// of its arguments (external arguments typed by a handled
/// parameter contribute that handler's motive).
fn family_gather_type(
  spec : DInductiveSpec,
  param_values : Array[DValue],
  handlers : Array[DFamilyParamHandler?],
  index_values : Array[DValue],
  value : DValue,
) -> DValue {
  eval_inductive_elim(
    spec,
    (_, _) => DVUniv(0),
    family_gather_cases(spec, param_values, handlers, true),
    param_values,
    index_values,
    value,
    0,
  )
}

///|
/// The bundle of induction hypotheses for all host-recursive
/// occurrences inside one element of an applied family, computed
/// by the inner family's eliminator at the motive
/// `family_gather_type`.
fn family_gather_map(
  spec : DInductiveSpec,
  param_values : Array[DValue],
  handlers : Array[DFamilyParamHandler?],
  index_values : Array[DValue],
  value : DValue,
) -> DValue {
  eval_inductive_elim(
    spec,
    (j, y) => family_gather_type(spec, param_values, handlers, j, y),
    family_gather_cases(spec, param_values, handlers, false),
    param_values,
    index_values,
    value,
    0,
  )
}

///|
fn family_gather_cases(
  spec : DInductiveSpec,
  param_values : Array[DValue],
  handlers : Array[DFamilyParamHandler?],
  want_type : Bool,
) -> Array[DValue] {
  let out : Array[DValue] = []
  for c in 0..<spec.constructors.length() {
    out.push(
      family_gather_case_go(
        spec,
        param_values,
        handlers,
        spec.constructors[c],
        0,
        [],
        [],
        want_type,
      ),
    )
  }
  out
}

///|
fn family_gather_case_go(
  spec : DInductiveSpec,
  param_values : Array[DValue],
  handlers : Array[DFamilyParamHandler?],
  ctor : DConstructorSpec,
  arg_index : Int32,
  prior : Array[DValue],
  contribs : Array[DValue],
  want_type : Bool,
) -> DValue {
  if arg_index >= ctor.args.length() {
    // Consume (and ignore) the constraint proofs, then assemble
    // the nested Sigma/pair bundle.
    let mut core = if want_type {
      let mut acc : DValue = DVUnitTy
      let mut i = contribs.length() - 1
      while i >= 0 {
        let head = contribs[i]
        let rest = acc
        acc = DVSigma(head, _ => rest)
        i = i - 1
      }
      acc
    } else {
      let mut acc : DValue = DVUnit
      let mut i = contribs.length() - 1
      while i >= 0 {
        acc = DVPair(contribs[i], acc)
        i = i - 1
      }
      acc
    }
    for _k in 0..<ctor.constraints.length() {
      let inner = core
      core = DVLam(_ => inner)
    }
    return core
  }
  let arg = ctor.args[arg_index]
  let needs_ih = match arg.kind {
    DArgExternal | DArgDecoded => false
    _ => true
  }
  DVLam(av => {
    let proceed = (ihv : DValue) => {
      let contrib = family_gather_arg_contribution(
        spec, param_values, handlers, ctor, arg_index, prior, av, ihv, want_type,
      )
      family_gather_case_go(
        spec,
        param_values,
        handlers,
        ctor,
        arg_index + 1,
        schema_concat_values(prior, [av]),
        schema_concat_values(contribs, [contrib]),
        want_type,
      )
    }
    if needs_ih {
      DVLam(ihv => proceed(ihv))
    } else {
      proceed(DVUnit)
    }
  })
}

///|
fn family_gather_arg_contribution(
  spec : DInductiveSpec,
  param_values : Array[DValue],
  handlers : Array[DFamilyParamHandler?],
  ctor : DConstructorSpec,
  arg_index : Int32,
  prior : Array[DValue],
  value : DValue,
  ih : DValue,
  want_type : Bool,
) -> DValue {
  let arg = ctor.args[arg_index]
  match arg.kind {
    DArgExternal =>
      family_gather_term_shape(
        handlers,
        schema_concat_values(param_values, prior),
        arg.ty,
        value,
        want_type,
      )
    DArgRecursive => ih
    DArgFunction =>
      if want_type {
        let dom = schema_eval_under(
          arg.ty,
          schema_concat_values(param_values, prior),
          [],
        )
        DVPi(dom, a => {
          family_gather_type(
            spec,
            param_values,
            handlers,
            schema_eval_index_terms(
              param_values,
              schema_concat_values(prior, [a]),
              arg.index,
            ),
            dapp_typed(value, a, dom),
          )
        })
      } else {
        ih
      }
    DArgNested =>
      family_gather_functor(
        spec,
        param_values,
        handlers,
        prior,
        arg.nested,
        value,
        want_type,
      )
    DArgDecoded => if want_type { DVUnitTy } else { DVUnit }
    DArgDecodedFunction =>
      if want_type {
        let prior_specs = schema_arg_spec_prefix(ctor.args, arg_index)
        let dom = eval_inductive_decode(
          spec,
          param_values,
          schema_source_indices(arg, prior_specs, param_values, prior),
          schema_source_value(arg, prior),
          0,
        )
        DVPi(dom, a => {
          family_gather_type(
            spec,
            param_values,
            handlers,
            schema_eval_index_terms(
              param_values,
              schema_concat_values(prior, [a]),
              arg.index,
            ),
            dapp_typed(value, a, dom),
          )
        })
      } else {
        ih
      }
  }
}

///|
/// Gather bundles inside one nested-functor value of the family
/// `spec` at `param_values`.  This is `positive_functor_ih_type`
/// resp. `positive_functor_map` with three changes: identity
/// leaves use the inner family's gather, constant leaves typed by
/// a handled parameter use that parameter's handler, and family
/// leaves compose handlers (the current family's gather for
/// `Self` arguments, pass-through for parameter variables).
fn family_gather_functor(
  spec : DInductiveSpec,
  param_values : Array[DValue],
  handlers : Array[DFamilyParamHandler?],
  prior : Array[DValue],
  functor : DPositiveFunctor,
  value : DValue,
  want_type : Bool,
) -> DValue {
  let inner_family = (idx : Array[DValue]) => {
    DVInductive(spec, param_values, idx)
  }
  match functor {
    DFunctorIdentity(index) => {
      let idxv = schema_eval_index_terms(param_values, prior, index)
      if want_type {
        family_gather_type(spec, param_values, handlers, idxv, value)
      } else {
        family_gather_map(spec, param_values, handlers, idxv, value)
      }
    }
    DFunctorConst(ty) =>
      family_gather_term_shape(
        handlers,
        schema_concat_values(param_values, prior),
        ty,
        value,
        want_type,
      )
    DFunctorProduct(a, b) => {
      let ta = positive_functor_type(a, param_values, prior, inner_family)
      let tb = positive_functor_type(b, param_values, prior, inner_family)
      let x = dfst_typed(value, _ => tb)
      let y = dsnd_typed(value, ta, _ => tb)
      let gx = family_gather_functor(
        spec, param_values, handlers, prior, a, x, want_type,
      )
      let gy = family_gather_functor(
        spec, param_values, handlers, prior, b, y, want_type,
      )
      if want_type {
        DVSigma(gx, _ => gy)
      } else {
        DVPair(gx, gy)
      }
    }
    DFunctorSum(a, b) => {
      let ta = positive_functor_type(a, param_values, prior, inner_family)
      let tb = positive_functor_type(b, param_values, prior, inner_family)
      let fam = positive_sum_family(ta, tb)
      let tag = dfst_typed(value, fam)
      let payload = dsnd_typed(value, DVBoolTy, fam)
      match force_value(tag) {
        DVBool(true) =>
          family_gather_functor(
            spec, param_values, handlers, prior, a, payload, want_type,
          )
        DVBool(false) =>
          family_gather_functor(
            spec, param_values, handlers, prior, b, payload, want_type,
          )
        _ =>
          if want_type {
            eval_bool_elim(
              _ => DVUniv(spec.level),
              family_gather_functor(
                spec, param_values, handlers, prior, a, payload, true,
              ),
              family_gather_functor(
                spec, param_values, handlers, prior, b, payload, true,
              ),
              tag,
              0,
            )
          } else {
            eval_bool_elim(
              t => {
                family_gather_functor(
                  spec,
                  param_values,
                  handlers,
                  prior,
                  DFunctorSum(a, b),
                  DVPair(t, payload),
                  true,
                )
              },
              family_gather_functor(
                spec, param_values, handlers, prior, a, payload, false,
              ),
              family_gather_functor(
                spec, param_values, handlers, prior, b, payload, false,
              ),
              tag,
              0,
            )
          }
      }
    }
    DFunctorList(inner) => {
      let elem = positive_functor_type(inner, param_values, prior, inner_family)
      if want_type {
        let step : DValue = DVLam(x => {
          DVLam(_xs => {
            DVLam(ih => {
              DVSigma(
                family_gather_functor(
                  spec, param_values, handlers, prior, inner, x, true,
                ),
                _ => ih,
              )
            })
          })
        })
        eval_list_elim(elem, _ => DVUniv(spec.level), DVUnitTy, step, value, 0)
      } else {
        let step : DValue = DVLam(x => {
          DVLam(_xs => {
            DVLam(ih => {
              DVPair(
                family_gather_functor(
                  spec, param_values, handlers, prior, inner, x, false,
                ),
                ih,
              )
            })
          })
        })
        eval_list_elim(
          elem,
          xs => {
            family_gather_functor(
              spec,
              param_values,
              handlers,
              prior,
              DFunctorList(inner),
              xs,
              true,
            )
          },
          DVUnit,
          step,
          value,
          0,
        )
      }
    }
    DFunctorContainer(shape, positions, index) => {
      let shape_ty = schema_eval_under(
        shape,
        schema_concat_values(param_values, prior),
        [],
      )
      let branch : (DValue) -> DValue = s => {
        let prior_s = schema_concat_values(prior, [s])
        let pos_ty = schema_eval_under(
          positions,
          schema_concat_values(param_values, prior_s),
          [],
        )
        DVPi(pos_ty, p => {
          inner_family(
            schema_eval_index_terms(
              param_values,
              schema_concat_values(prior_s, [p]),
              index,
            ),
          )
        })
      }
      let s = dfst_typed(value, branch)
      let contents = dsnd_typed(value, shape_ty, branch)
      let prior_s = schema_concat_values(prior, [s])
      let pos_ty = schema_eval_under(
        positions,
        schema_concat_values(param_values, prior_s),
        [],
      )
      if want_type {
        DVPi(pos_ty, p => {
          family_gather_type(
            spec,
            param_values,
            handlers,
            schema_eval_index_terms(
              param_values,
              schema_concat_values(prior_s, [p]),
              index,
            ),
            dapp_typed(contents, p, pos_ty),
          )
        })
      } else {
        DVLam(p => {
          family_gather_map(
            spec,
            param_values,
            handlers,
            schema_eval_index_terms(
              param_values,
              schema_concat_values(prior_s, [p]),
              index,
            ),
            dapp_typed(contents, p, pos_ty),
          )
        })
      }
    }
    DFunctorPi(dom, inner) => {
      let dv = schema_eval_under(
        dom,
        schema_concat_values(param_values, prior),
        [],
      )
      if want_type {
        DVPi(dv, a => {
          family_gather_functor(
            spec,
            param_values,
            handlers,
            schema_concat_values(prior, [a]),
            inner,
            dapp_typed(value, a, dv),
            true,
          )
        })
      } else {
        DVLam(a => {
          family_gather_functor(
            spec,
            param_values,
            handlers,
            schema_concat_values(prior, [a]),
            inner,
            dapp_typed(value, a, dv),
            false,
          )
        })
      }
    }
    DFunctorSigma(a, b) => {
      let ta = positive_functor_type(a, param_values, prior, inner_family)
      let tb_family : (DValue) -> DValue = v => {
        positive_functor_type(
          b,
          param_values,
          schema_concat_values(prior, [v]),
          inner_family,
        )
      }
      let x = dfst_typed(value, tb_family)
      let y = dsnd_typed(value, ta, tb_family)
      let gx = family_gather_functor(
        spec, param_values, handlers, prior, a, x, want_type,
      )
      let gy = family_gather_functor(
        spec,
        param_values,
        handlers,
        schema_concat_values(prior, [x]),
        b,
        y,
        want_type,
      )
      if want_type {
        DVSigma(gx, _ => gy)
      } else {
        DVPair(gx, gy)
      }
    }
    DFunctorFamily(spec3, pargs3, index3) => {
      let (param_values3, handlers3, index_values3) = family_instantiate(
        pargs3,
        index3,
        param_values,
        prior,
        js => inner_family(js),
        js => {
          type_of: y => family_gather_type(spec, param_values, handlers, js, y),
          map_of: y => family_gather_map(spec, param_values, handlers, js, y),
        },
        handlers,
      )
      if want_type {
        family_gather_type(
          spec3, param_values3, handlers3, index_values3, value,
        )
      } else {
        family_gather_map(spec3, param_values3, handlers3, index_values3, value)
      }
    }
    DFunctorSelfFamily(pargs3, index3) => {
      // The applied family is `spec` itself at a new parameter
      // instantiation; gather handlers compose exactly as for an
      // explicit family application.
      let (param_values3, handlers3, index_values3) = family_instantiate(
        pargs3,
        index3,
        param_values,
        prior,
        js => inner_family(js),
        js => {
          type_of: y => family_gather_type(spec, param_values, handlers, js, y),
          map_of: y => family_gather_map(spec, param_values, handlers, js, y),
        },
        handlers,
      )
      if want_type {
        family_gather_type(spec, param_values3, handlers3, index_values3, value)
      } else {
        family_gather_map(spec, param_values3, handlers3, index_values3, value)
      }
    }
  }
}

///|
fn dterm_free_var_occurs(t : DTerm, var_index : Int32) -> Bool {
  let mut found = false
  ignore(
    dterm_map_vars_at(t, 0, (i, depth) => {
      if i - depth == var_index {
        found = true
      }
      DTVar(i)
    }),
  )
  found
}

///|
/// Whether every occurrence of parameter `param_pos` in the
/// type term `ty` (read in a context of length `ctx_len`,
/// parameters first) is in a shape the gatherer can traverse:
/// a whole leaf, under lists or dependent pairs, in a function
/// codomain, or inside parameter arguments of an applied
/// declared family whose corresponding parameters are
/// themselves gatherable.  Occurrences in function domains and
/// opaque applications are not traversable.
fn term_param_shape_gatherable(
  ty : DTerm,
  ctx_len : Int32,
  param_pos : Int32,
) -> Bool {
  let var_index = ctx_len - 1 - param_pos
  match ty {
    DTVar(_) => true
    DListTy(inner) => term_param_shape_gatherable(inner, ctx_len, param_pos)
    DSigma(a, b) =>
      term_param_shape_gatherable(a, ctx_len, param_pos) &&
      term_param_shape_gatherable(b, ctx_len + 1, param_pos)
    DPi(dom, cod) =>
      !dterm_free_var_occurs(dom, var_index) &&
      term_param_shape_gatherable(cod, ctx_len + 1, param_pos)
    DInductive(spec2, args) => {
      if args.length() < spec2.params.length() {
        return !dterm_free_var_occurs(ty, var_index)
      }
      for k in 0..<spec2.params.length() {
        if dterm_free_var_occurs(args[k], var_index) &&
          !(term_param_shape_gatherable(args[k], ctx_len, param_pos) &&
          spec_param_gatherable(spec2, k)) {
          return false
        }
      }
      true
    }
    _ => !dterm_free_var_occurs(ty, var_index)
  }
}

///|
/// Whether induction hypotheses can be gathered for elements
/// stored at parameter `param_pos` of `spec` when that parameter
/// is instantiated by the family being declared: every stored
/// occurrence of the parameter must lie in a traversable type
/// shape (`term_param_shape_gatherable`: leaves, lists, pairs,
/// function codomains, applied-family arguments), never a
/// function/container domain, and decoded
/// argument kinds are excluded outright.  Occurrences in index
/// terms are unrestricted (indices are not stored data), and a
/// pass-through into a further applied family requires that
/// family's parameter to be gatherable as well.  Self-family
/// pass-throughs are read coinductively: re-entering a parameter
/// already under examination succeeds, because gathering over a
/// finite value descends structurally smaller subvalues before
/// ever re-reaching that parameter.
fn spec_param_gatherable(spec : DInductiveSpec, param_pos : Int32) -> Bool {
  let active : Array[Bool] = []
  for _i in 0..<spec.params.length() {
    active.push(false)
  }
  spec_param_gatherable_go(spec, param_pos, active)
}

///|
fn spec_param_gatherable_go(
  spec : DInductiveSpec,
  param_pos : Int32,
  active : Array[Bool],
) -> Bool {
  let nparams = spec.params.length()
  if param_pos < 0 || param_pos >= nparams {
    return false
  }
  if active[param_pos] {
    return true
  }
  active[param_pos] = true
  let mut ok = true
  for c in 0..<spec.constructors.length() {
    let ctor = spec.constructors[c]
    for i in 0..<ctor.args.length() {
      let arg = ctor.args[i]
      let ctx_len = nparams + i
      let var_index = ctx_len - 1 - param_pos
      let arg_ok = match arg.kind {
        DArgExternal => term_param_shape_gatherable(arg.ty, ctx_len, param_pos)
        DArgRecursive => true
        DArgFunction => !dterm_free_var_occurs(arg.ty, var_index)
        DArgNested =>
          functor_param_gatherable(spec, arg.nested, i, param_pos, active)
        DArgDecoded | DArgDecodedFunction => false
      }
      if !arg_ok {
        ok = false
      }
    }
  }
  active[param_pos] = false
  ok
}

///|
fn functor_param_gatherable(
  spec : DInductiveSpec,
  functor : DPositiveFunctor,
  prior_len : Int32,
  param_pos : Int32,
  active : Array[Bool],
) -> Bool {
  let nparams = spec.params.length()
  let ctx_len = nparams + prior_len
  let var_index = ctx_len - 1 - param_pos
  match functor {
    DFunctorIdentity(_) => true
    DFunctorConst(ty) => term_param_shape_gatherable(ty, ctx_len, param_pos)
    DFunctorProduct(a, b) | DFunctorSum(a, b) =>
      functor_param_gatherable(spec, a, prior_len, param_pos, active) &&
      functor_param_gatherable(spec, b, prior_len, param_pos, active)
    DFunctorList(inner) =>
      functor_param_gatherable(spec, inner, prior_len, param_pos, active)
    DFunctorPi(dom, inner) =>
      !dterm_free_var_occurs(dom, var_index) &&
      functor_param_gatherable(spec, inner, prior_len + 1, param_pos, active)
    DFunctorContainer(shape, positions, _) =>
      !dterm_free_var_occurs(shape, var_index) &&
      !dterm_free_var_occurs(positions, var_index + 1)
    DFunctorSigma(a, b) =>
      functor_param_gatherable(spec, a, prior_len, param_pos, active) &&
      functor_param_gatherable(spec, b, prior_len + 1, param_pos, active)
    DFunctorFamily(spec3, pargs3, _) => {
      let mut ok = pargs3.length() == spec3.params.length()
      for k in 0..<pargs3.length() {
        match pargs3[k] {
          DFunctorParamTerm(t) =>
            if dterm_free_var_occurs(t, var_index) {
              ok = ok &&
                term_param_shape_gatherable(t, ctx_len, param_pos) &&
                spec_param_gatherable(spec3, k)
            }
          DFunctorParamSelf(_) => ()
        }
      }
      ok
    }
    DFunctorSelfFamily(pargs3, _) => {
      let mut ok = pargs3.length() == nparams
      for k in 0..<pargs3.length() {
        match pargs3[k] {
          DFunctorParamTerm(t) =>
            if dterm_free_var_occurs(t, var_index) {
              ok = ok &&
                term_param_shape_gatherable(t, ctx_len, param_pos) &&
                spec_param_gatherable_go(spec, k, active)
            }
          DFunctorParamSelf(_) => ()
        }
      }
      ok
    }
  }
}

///|
/// Recover the inductive spec under declaration from the
/// validation `self_type` oracle.  `None` for HIT declarations,
/// whose cells do not support the self-family node.
fn validation_self_spec(
  self_type : (Array[DValue], Array[DValue]) -> DValue,
  params : Array[DTelescopeEntry],
  indices : Array[DTelescopeEntry],
  prefix_values : Array[DValue],
) -> DInductiveSpec? {
  let host_params : Array[DValue] = []
  for h in 0..<params.length() {
    if h < prefix_values.length() {
      host_params.push(prefix_values[h])
    }
  }
  let probe_indices : Array[DValue] = []
  for h in 0..<indices.length() {
    probe_indices.push(DVNeutral(DNVar(9600 + h)))
  }
  match force_value(self_type(host_params, probe_indices)) {
    DVInductive(spec, _, _) => Some(spec)
    _ => None
  }
}

///|
fn positive_functor_validate(
  functor : DPositiveFunctor,
  family_name : String,
  params : Array[DTelescopeEntry],
  indices : Array[DTelescopeEntry],
  prefix_types : Array[DValue],
  prefix_values : Array[DValue],
  self_type : (Array[DValue], Array[DValue]) -> DValue,
) -> DValue? {
  match functor {
    DFunctorIdentity(index) =>
      if schema_check_index_terms(
          indices, params, prefix_types, prefix_values, index,
        ) {
        Some(DVUnitTy)
      } else {
        None
      }
    DFunctorConst(ty) => {
      if schema_term_mentions_family(ty, family_name) {
        return None
      }
      match
        d_as_type(
          ty,
          schema_env(prefix_types),
          schema_env(prefix_values),
          ddim_empty(),
        ) {
        Some(tv) => Some(tv.value)
        None => None
      }
    }
    DFunctorProduct(a, b) =>
      match
        (
          positive_functor_validate(
            a, family_name, params, indices, prefix_types, prefix_values, self_type,
          ),
          positive_functor_validate(
            b, family_name, params, indices, prefix_types, prefix_values, self_type,
          ),
        ) {
        (Some(ta), Some(tb)) => Some(DVSigma(ta, _ => tb))
        _ => None
      }
    DFunctorSum(a, b) =>
      match
        (
          positive_functor_validate(
            a, family_name, params, indices, prefix_types, prefix_values, self_type,
          ),
          positive_functor_validate(
            b, family_name, params, indices, prefix_types, prefix_values, self_type,
          ),
        ) {
        (Some(ta), Some(tb)) =>
          Some(DVSigma(DVBoolTy, positive_sum_family(ta, tb)))
        _ => None
      }
    DFunctorList(inner) =>
      match
        positive_functor_validate(
          inner, family_name, params, indices, prefix_types, prefix_values, self_type,
        ) {
        Some(t) => Some(DVListTy(t))
        None => None
      }
    DFunctorContainer(shape, positions, index) => {
      if schema_term_mentions_family(shape, family_name) ||
        schema_term_mentions_family(positions, family_name) {
        return None
      }
      match
        d_as_type(
          shape,
          schema_env(prefix_types),
          schema_env(prefix_values),
          ddim_empty(),
        ) {
        Some(shape_tv) => {
          let shape_types = schema_concat_values(prefix_types, [shape_tv.value])
          let shape_values = schema_concat_values(prefix_values, [
            DVNeutral(DNVar(9300 + prefix_values.length())),
          ])
          match
            d_as_type(
              positions,
              schema_env(shape_types),
              schema_env(shape_values),
              ddim_empty(),
            ) {
            Some(pos_tv) => {
              let index_types = schema_concat_values(shape_types, [pos_tv.value])
              let index_values = schema_concat_values(shape_values, [
                DVNeutral(DNVar(9400 + prefix_values.length())),
              ])
              if schema_check_index_terms(
                  indices, params, index_types, index_values, index,
                ) {
                Some(
                  DVSigma(shape_tv.value, s => {
                    DVPi(
                      schema_eval_under(
                        positions,
                        schema_concat_values(prefix_values, [s]),
                        [],
                      ),
                      _ => DVUnitTy,
                    )
                  }),
                )
              } else {
                None
              }
            }
            None => None
          }
        }
        None => None
      }
    }
    DFunctorSigma(a, b) =>
      match
        positive_functor_validate(
          a, family_name, params, indices, prefix_types, prefix_values, self_type,
        ) {
        Some(ta) => {
          let inner_types = schema_concat_values(prefix_types, [ta])
          let inner_values = schema_concat_values(prefix_values, [
            DVNeutral(DNVar(9500 + prefix_values.length())),
          ])
          match
            positive_functor_validate(
              b, family_name, params, indices, inner_types, inner_values, self_type,
            ) {
            Some(_) =>
              Some(
                DVSigma(ta, v => {
                  match
                    positive_functor_validate(
                      b,
                      family_name,
                      params,
                      indices,
                      schema_concat_values(prefix_types, [ta]),
                      schema_concat_values(prefix_values, [v]),
                      self_type,
                    ) {
                    Some(t) => t
                    None => DVUnitTy
                  }
                }),
              )
            None => None
          }
        }
        None => None
      }
    DFunctorPi(dom, inner) => {
      if schema_term_mentions_family(dom, family_name) {
        return None
      }
      match
        d_as_type(
          dom,
          schema_env(prefix_types),
          schema_env(prefix_values),
          ddim_empty(),
        ) {
        Some(tv) => {
          let inner_types = schema_concat_values(prefix_types, [tv.value])
          let inner_values = schema_concat_values(prefix_values, [
            DVNeutral(DNVar(9100 + prefix_values.length())),
          ])
          match
            positive_functor_validate(
              inner, family_name, params, indices, inner_types, inner_values, self_type,
            ) {
            Some(_) =>
              Some(
                DVPi(tv.value, a => {
                  match
                    positive_functor_validate(
                      inner,
                      family_name,
                      params,
                      indices,
                      schema_concat_values(prefix_types, [tv.value]),
                      schema_concat_values(prefix_values, [a]),
                      self_type,
                    ) {
                    Some(t) => t
                    None => DVUnitTy
                  }
                }),
              )
            None => None
          }
        }
        None => None
      }
    }
    DFunctorFamily(spec2, pargs, index) => {
      if pargs.length() != spec2.params.length() ||
        index.length() != spec2.indices.length() {
        return None
      }
      // Instantiate the inner parameter telescope stepwise.
      // `Self` entries are instantiated with the *actual* host
      // family type (threaded in as `self_type` from the
      // declaration being validated), so later *Term*
      // parameters whose types depend on a `Self` type parameter
      // are checked at their real expected types.  The `Self`
      // indices themselves are checked against the host
      // telescope, and the inner parameter must be gatherable.
      let inst_types : Array[DValue] = []
      let inst_values : Array[DValue] = []
      for k in 0..<spec2.params.length() {
        let pty = match
          d_as_type(
            spec2.params[k].ty,
            schema_env(inst_types),
            schema_env(inst_values),
            ddim_empty(),
          ) {
          Some(tv) => tv.value
          None => return None
        }
        inst_types.push(pty)
        match pargs[k] {
          DFunctorParamTerm(t) => {
            if schema_term_mentions_family(t, family_name) {
              return None
            }
            match
              d_check(
                t,
                pty,
                schema_env(prefix_types),
                schema_env(prefix_values),
                ddim_empty(),
              ) {
              Some(v) => inst_values.push(v)
              None => return None
            }
          }
          DFunctorParamSelf(js) => {
            match force_value(pty) {
              DVUniv(_) => ()
              _ => return None
            }
            if !schema_check_index_terms(
                indices, params, prefix_types, prefix_values, js,
              ) ||
              !spec_param_gatherable(spec2, k) {
              return None
            }
            inst_values.push(
              schema_validation_self_type(self_type, params, prefix_values, js),
            )
          }
        }
      }
      // Check the inner index vector against its telescope at
      // the instantiated parameters; the terms live in the host
      // prefix.
      let idx_types : Array[DValue] = []
      let idx_values : Array[DValue] = []
      for i in 0..<inst_types.length() {
        idx_types.push(inst_types[i])
        idx_values.push(inst_values[i])
      }
      let index_values : Array[DValue] = []
      for i in 0..<spec2.indices.length() {
        let ity = match
          d_as_type(
            spec2.indices[i].ty,
            schema_env(idx_types),
            schema_env(idx_values),
            ddim_empty(),
          ) {
          Some(tv) => tv.value
          None => return None
        }
        match
          d_check(
            index[i],
            ity,
            schema_env(prefix_types),
            schema_env(prefix_values),
            ddim_empty(),
          ) {
          Some(v) => {
            index_values.push(v)
            idx_types.push(ity)
            idx_values.push(v)
          }
          None => return None
        }
      }
      Some(DVInductive(spec2, inst_values, index_values))
    }
    DFunctorSelfFamily(pargs, index) =>
      // Resolve the implicit target to the declaration under
      // validation and reuse the explicit-family checks.  This
      // includes gatherability of every `Self` parameter slot of
      // the host itself (read coinductively by
      // `spec_param_gatherable_go`).
      match validation_self_spec(self_type, params, indices, prefix_values) {
        Some(host) =>
          positive_functor_validate(
            DFunctorFamily(host, pargs, index),
            family_name,
            params,
            indices,
            prefix_types,
            prefix_values,
            self_type,
          )
        None => None
      }
  }
}

///|
/// Full form of `schema_arg_type`, with earlier argument descriptors
/// and an induction-recursive decoding function available.
pub fn schema_arg_type_full(
  arg : DConstructorArg,
  prior_specs : Array[DConstructorArg],
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
  decode : (Array[DValue], DValue) -> DValue,
) -> DValue {
  match arg.kind {
    DArgExternal =>
      schema_eval_under(arg.ty, schema_concat_values(params, prior), [])
    DArgRecursive => family(schema_eval_index_terms(params, prior, arg.index))
    DArgFunction => {
      let dom = schema_eval_under(arg.ty, schema_concat_values(params, prior), [])
      DVPi(dom, a => {
        family(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior, [a]),
            arg.index,
          ),
        )
      })
    }
    DArgNested => positive_functor_type(arg.nested, params, prior, family)
    DArgDecoded =>
      decode(
        schema_source_indices(arg, prior_specs, params, prior),
        schema_source_value(arg, prior),
      )
    DArgDecodedFunction => {
      let dom = decode(
        schema_source_indices(arg, prior_specs, params, prior),
        schema_source_value(arg, prior),
      )
      DVPi(dom, a => {
        family(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior, [a]),
            arg.index,
          ),
        )
      })
    }
  }
}

///|
pub fn inductive_arg_type_full(
  spec : DInductiveSpec,
  arg : DConstructorArg,
  prior_specs : Array[DConstructorArg],
  params : Array[DValue],
  prior : Array[DValue],
) -> DValue {
  schema_arg_type_full(
    arg,
    prior_specs,
    params,
    prior,
    idx => DVInductive(spec, params, idx),
    (idx, code) => eval_inductive_decode(spec, params, idx, code, 0),
  )
}

///|
/// Evaluate the type and endpoints of one constructor constraint.
pub fn schema_constraint_parts(
  constraint : DConstructorConstraint,
  params : Array[DValue],
  args : Array[DValue],
) -> (DValue, DValue, DValue) {
  let values = schema_concat_values(params, args)
  (
    schema_eval_under(constraint.ty, values, []),
    schema_eval_under(constraint.lhs, values, []),
    schema_eval_under(constraint.rhs, values, []),
  )
}

///|
pub fn schema_constraints_hold(
  level : Int32,
  dlevel : Int32,
  constraints : Array[DConstructorConstraint],
  params : Array[DValue],
  args : Array[DValue],
) -> Bool {
  for i in 0..<constraints.length() {
    let (ty, lhs, rhs) = schema_constraint_parts(constraints[i], params, args)
    if !conv_at(level, dlevel, ty, lhs, rhs) {
      return false
    }
  }
  true
}

///|
fn schema_constraints_pi_loop(
  constraints : Array[DConstructorConstraint],
  pos : Int32,
  params : Array[DValue],
  args : Array[DValue],
  rest : DValue,
) -> DValue {
  if pos >= constraints.length() {
    rest
  } else {
    let (ty, lhs, rhs) = schema_constraint_parts(constraints[pos], params, args)
    DVPi(DVPathTy(_ => ty, lhs, rhs), _ => {
      schema_constraints_pi_loop(constraints, pos + 1, params, args, rest)
    })
  }
}

///|
/// Prefix a case type by Path arguments for all constraints.
pub fn schema_constraints_pi(
  constraints : Array[DConstructorConstraint],
  params : Array[DValue],
  args : Array[DValue],
  rest : DValue,
) -> DValue {
  schema_constraints_pi_loop(constraints, 0, params, args, rest)
}

///|
/// Supply reflexivity proofs for the (checked) constraints of a
/// canonical introduction.
pub fn schema_apply_constraint_proofs(
  case_value : DValue,
  constraints : Array[DConstructorConstraint],
  params : Array[DValue],
  args : Array[DValue],
) -> DValue {
  let mut cur = case_value
  for i in 0..<constraints.length() {
    let (ty, lhs, rhs) = schema_constraint_parts(constraints[i], params, args)
    cur = dapp_typed(cur, DVPathLam(_ => lhs), DVPathTy(_ => ty, lhs, rhs))
  }
  cur
}

///|
pub fn conv_schema_args_full(
  level : Int32,
  dlevel : Int32,
  args : Array[DConstructorArg],
  params : Array[DValue],
  family : (Array[DValue]) -> DValue,
  decode : (Array[DValue], DValue) -> DValue,
  a : Array[DValue],
  b : Array[DValue],
) -> Bool {
  if a.length() != b.length() || a.length() != args.length() {
    return false
  }
  let prior : Array[DValue] = []
  for i in 0..<a.length() {
    let ty = schema_arg_type_full(
      args[i],
      schema_arg_spec_prefix(args, i),
      params,
      prior,
      family,
      decode,
    )
    if !conv_at(level, dlevel, ty, a[i], b[i]) {
      return false
    }
    prior.push(a[i])
  }
  true
}

///|
pub fn quote_schema_args_full(
  level : Int32,
  dlevel : Int32,
  args : Array[DConstructorArg],
  params : Array[DValue],
  family : (Array[DValue]) -> DValue,
  decode : (Array[DValue], DValue) -> DValue,
  values : Array[DValue],
) -> Array[DTerm] {
  let out : Array[DTerm] = []
  let prior : Array[DValue] = []
  for i in 0..<values.length() {
    let ty = if i < args.length() {
      schema_arg_type_full(
        args[i],
        schema_arg_spec_prefix(args, i),
        params,
        prior,
        family,
        decode,
      )
    } else {
      DVUnitTy
    }
    out.push(quote_at(level, dlevel, ty, values[i]))
    prior.push(values[i])
  }
  out
}

// ---------------------------------------------------------------------------
// Induction-recursion: decoding
// ---------------------------------------------------------------------------

///|
/// Decode a code of an induction-recursive family.  Canonical codes
/// compute by their decode case; neutral codes give a neutral decoded
/// type; formal compositions are mapped through the universe.
pub fn eval_inductive_decode(
  spec : DInductiveSpec,
  params : Array[DValue],
  indices : Array[DValue],
  code : DValue,
  dlevel : Int32,
) -> DValue {
  if spec.decode_cases.length() == 0 {
    return DVUnitTy
  }
  match force_value(code) {
    DVIntro(spec2, ctor, params2, args) =>
      if spec2 != spec ||
        ctor < 0 ||
        ctor >= spec.constructors.length() ||
        ctor >= spec.decode_cases.length() {
        DVUnitTy
      } else {
        let ctor_spec = spec.constructors[ctor]
        let env_values : Array[DValue] = []
        for i in 0..<params2.length() {
          env_values.push(params2[i])
        }
        let prior : Array[DValue] = []
        for i in 0..<args.length() {
          if i >= ctor_spec.args.length() {
            break
          }
          let arg_spec = ctor_spec.args[i]
          let arg = args[i]
          env_values.push(arg)
          match arg_spec.kind {
            DArgRecursive => {
              let idx = schema_eval_index_terms(params2, prior, arg_spec.index)
              env_values.push(
                eval_inductive_decode(spec, params2, idx, arg, dlevel),
              )
            }
            DArgFunction => {
              let dom = schema_eval_under(
                arg_spec.ty,
                schema_concat_values(params2, prior),
                [],
              )
              let prior_copy = schema_concat_values([], prior)
              env_values.push(
                DVLam(a => {
                  let idx = schema_eval_index_terms(
                    params2,
                    schema_concat_values(prior_copy, [a]),
                    arg_spec.index,
                  )
                  eval_inductive_decode(
                    spec,
                    params2,
                    idx,
                    dapp_typed(arg, a, dom),
                    dlevel,
                  )
                }),
              )
            }
            DArgNested =>
              env_values.push(
                positive_functor_map(
                  arg_spec.nested,
                  params2,
                  prior,
                  idx => DVInductive(spec, params2, idx),
                  (_, _) => DVUniv(spec.decode_level),
                  (idx, x) => {
                    eval_inductive_decode(spec, params2, idx, x, dlevel)
                  },
                  arg,
                ),
              )
            DArgDecodedFunction => {
              let prior_specs = schema_arg_spec_prefix(ctor_spec.args, i)
              let source_idx = schema_source_indices(
                arg_spec, prior_specs, params2, prior,
              )
              let dom = eval_inductive_decode(
                spec,
                params2,
                source_idx,
                schema_source_value(arg_spec, prior),
                dlevel,
              )
              let prior_copy = schema_concat_values([], prior)
              env_values.push(
                DVLam(a => {
                  let idx = schema_eval_index_terms(
                    params2,
                    schema_concat_values(prior_copy, [a]),
                    arg_spec.index,
                  )
                  eval_inductive_decode(
                    spec,
                    params2,
                    idx,
                    dapp_typed(arg, a, dom),
                    dlevel,
                  )
                }),
              )
            }
            DArgExternal | DArgDecoded => ()
          }
          prior.push(arg)
        }
        for i in 0..<ctor_spec.constraints.length() {
          let (_, lhs, _) = schema_constraint_parts(
            ctor_spec.constraints[i],
            params2,
            args,
          )
          env_values.push(DVPathLam(_ => lhs))
        }
        deval_dim(spec.decode_cases[ctor], schema_env(env_values), ddim_empty())
      }
    DVNeutral(DNComp(line, branches, base)) =>
      elim_over_comp(
        line,
        branches,
        base,
        _ => DVUniv(spec.decode_level),
        v => eval_inductive_decode(spec, params, indices, v, dlevel),
        dlevel,
      )
    DVNeutral(DNHComp(ty, branches, base)) =>
      elim_over_comp(
        _ => ty,
        branches,
        base,
        _ => DVUniv(spec.decode_level),
        v => eval_inductive_decode(spec, params, indices, v, dlevel),
        dlevel,
      )
    DVNeutral(n) => DVNeutral(DNDecode(spec, params, indices, n))
    _ => DVUnitTy
  }
}

///|
pub fn eval_decode_term(
  spec : DInductiveSpec,
  param_terms : Array[DTerm],
  index_terms : Array[DTerm],
  code : DTerm,
  env : DEnv,
  denv : DDimEnv,
) -> DValue {
  let params : Array[DValue] = []
  for i in 0..<param_terms.length() {
    params.push(deval_dim(param_terms[i], env, denv))
  }
  let indices : Array[DValue] = []
  for i in 0..<index_terms.length() {
    indices.push(deval_dim(index_terms[i], env, denv))
  }
  eval_inductive_decode(
    spec,
    params,
    indices,
    deval_dim(code, env, denv),
    ddim_len(denv),
  )
}

///|
pub fn infer_decode(
  spec : DInductiveSpec,
  param_terms : Array[DTerm],
  index_terms : Array[DTerm],
  code : DTerm,
  ctx : DEnv,
  env : DEnv,
  denv : DDimEnv,
) -> DInfer? {
  if !inductive_schema_validate(spec) || spec.decode_cases.length() == 0 {
    return None
  }
  match
    check_telescope_terms(spec.params, param_terms, [], [], ctx, env, denv) {
    Some(params) =>
      match
        check_telescope_terms(
          spec.indices,
          index_terms,
          inductive_param_types(spec, params),
          params,
          ctx,
          env,
          denv,
        ) {
        Some(indices) =>
          match
            d_check(code, DVInductive(spec, params, indices), ctx, env, denv) {
            Some(code_value) =>
              Some(DInfer::{
                value: eval_inductive_decode(
                  spec,
                  params,
                  indices,
                  code_value,
                  ddim_len(denv),
                ),
                ty: DVUniv(spec.decode_level),
              })
            None => None
          }
        None => None
      }
    None => None
  }
}

///|
pub fn quote_decode_neutral(
  level : Int32,
  dlevel : Int32,
  spec : DInductiveSpec,
  params : Array[DValue],
  indices : Array[DValue],
  code : DNeutral,
) -> DTerm {
  DDecode(
    spec,
    quote_telescope_values(level, dlevel, spec.params, [], [], params),
    quote_telescope_values(
      level,
      dlevel,
      spec.indices,
      inductive_param_types(spec, params),
      params,
      indices,
    ),
    quote_dneutral(level, dlevel, code, DVInductive(spec, params, indices)),
  )
}

///|
pub fn conv_decode_neutral(
  level : Int32,
  dlevel : Int32,
  s1 : DInductiveSpec,
  p1 : Array[DValue],
  i1 : Array[DValue],
  n1 : DNeutral,
  s2 : DInductiveSpec,
  p2 : Array[DValue],
  i2 : Array[DValue],
  n2 : DNeutral,
) -> Bool {
  s1 == s2 &&
  conv_telescope_values(level, dlevel, s1.params, [], [], p1, p2) &&
  conv_telescope_values(
    level,
    dlevel,
    s1.indices,
    inductive_param_types(s1, p1),
    p1,
    i1,
    i2,
  ) &&
  conv_neutral(level, dlevel, n1, n2)
}

///|
/// The AST form of the decoding function.
pub fn decode_term(
  spec : DInductiveSpec,
  params : Array[DTerm],
  indices : Array[DTerm],
  code : DTerm,
) -> DTerm {
  DDecode(spec, params, indices, code)
}

///|
/// Check every decode case as a type-valued term in the context of
/// parameters, arguments, recursive decode hypotheses and constraint
/// proofs.
pub fn inductive_decode_cases_validate(spec : DInductiveSpec) -> Bool {
  if spec.decode_cases.length() == 0 {
    return true
  }
  if spec.decode_cases.length() != spec.constructors.length() ||
    spec.decode_level < 0 {
    return false
  }
  let param_values = schema_fresh_values(spec.params.length(), 8600)
  let param_types = inductive_param_types(spec, param_values)
  for c in 0..<spec.constructors.length() {
    let ctor = spec.constructors[c]
    let types : Array[DValue] = []
    let values : Array[DValue] = []
    for i in 0..<param_types.length() {
      types.push(param_types[i])
      values.push(param_values[i])
    }
    let prior : Array[DValue] = []
    for i in 0..<ctor.args.length() {
      let arg = ctor.args[i]
      let prior_specs = schema_arg_spec_prefix(ctor.args, i)
      let arg_ty = inductive_arg_type_full(
        spec, arg, prior_specs, param_values, prior,
      )
      let fresh = DVNeutral(DNVar(8700 + c * 40 + i))
      types.push(arg_ty)
      values.push(fresh)
      match arg.kind {
        DArgRecursive => {
          let idx = schema_eval_index_terms(param_values, prior, arg.index)
          types.push(DVUniv(spec.decode_level))
          values.push(eval_inductive_decode(spec, param_values, idx, fresh, 0))
        }
        DArgFunction => {
          let dom = schema_eval_under(
            arg.ty,
            schema_concat_values(param_values, prior),
            [],
          )
          types.push(DVPi(dom, _ => DVUniv(spec.decode_level)))
          values.push(
            DVLam(a => {
              let idx = schema_eval_index_terms(
                param_values,
                schema_concat_values(prior, [a]),
                arg.index,
              )
              eval_inductive_decode(
                spec,
                param_values,
                idx,
                dapp_typed(fresh, a, dom),
                0,
              )
            }),
          )
        }
        DArgNested => {
          types.push(
            positive_functor_ih_type(
              arg.nested,
              param_values,
              prior,
              idx => DVInductive(spec, param_values, idx),
              (_, _) => DVUniv(spec.decode_level),
              fresh,
            ),
          )
          values.push(
            positive_functor_map(
              arg.nested,
              param_values,
              prior,
              idx => DVInductive(spec, param_values, idx),
              (_, _) => DVUniv(spec.decode_level),
              (idx, x) => eval_inductive_decode(spec, param_values, idx, x, 0),
              fresh,
            ),
          )
        }
        DArgDecodedFunction => {
          let dom = eval_inductive_decode(
            spec,
            param_values,
            schema_source_indices(arg, prior_specs, param_values, prior),
            schema_source_value(arg, prior),
            0,
          )
          types.push(DVPi(dom, _ => DVUniv(spec.decode_level)))
          values.push(
            DVLam(a => {
              let idx = schema_eval_index_terms(
                param_values,
                schema_concat_values(prior, [a]),
                arg.index,
              )
              eval_inductive_decode(
                spec,
                param_values,
                idx,
                dapp_typed(fresh, a, dom),
                0,
              )
            }),
          )
        }
        DArgExternal | DArgDecoded => ()
      }
      prior.push(fresh)
    }
    for i in 0..<ctor.constraints.length() {
      let (ty, lhs, rhs) = schema_constraint_parts(
        ctor.constraints[i],
        param_values,
        prior,
      )
      types.push(DVPathTy(_ => ty, lhs, rhs))
      values.push(DVPathLam(_ => lhs))
    }
    match
      d_check(
        spec.decode_cases[c],
        DVUniv(spec.decode_level),
        schema_env(types),
        schema_env(values),
        ddim_empty(),
      ) {
      Some(_) => ()
      None => return false
    }
  }
  true
}
