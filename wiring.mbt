///|
// Symbolic finite equivalences as wirings (signed permutations of leaves).
//
// Flatten a finite type Ty to its leaf sequence (Bool / Unit in order).
// Every equivalence generated by id, not, swap, products, composition and
// inverses acts leaf-wise: each output Bool leaf is some input Bool leaf,
// possibly negated; output Unit leaves are constant.  Such a map is a
// *wiring*: for each output leaf, a source index and a negation flag
// (source −1 for Unit outputs, canonically).
//
// Wirings are canonical forms for this fragment:
//   * composition is index substitution with XOR of negation flags;
//   * inverse is permutation inversion;
//   * equality of equivalences is structural equality of wirings;
//   * being an equivalence is the permutation property — decidable on the
//     index lists in O(#leaves), never by enumerating 2^k elements.
//
// Categorically, wirings are the morphisms of the free symmetric monoidal
// category (with a chosen involution on the Bool generator) on these
// types: Ty are objects, wiring_prod is the tensor on morphisms, swap is
// the braiding, and the pentagon / triangle / hexagon coherence laws are
// checked below as wiring equalities.

///|
pub enum LeafKind {
  LKBool
  LKUnit
} derive(Debug, Eq)

///|
pub extend LeafKind with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend LeafKind with Eq::{not_equal, equal}

///|
pub struct LeafMap {
  src_index : Int32 // -1 for constant Unit outputs
  neg : Bool
} derive(Debug, Eq)

///|
pub extend LeafMap with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend LeafMap with Eq::{not_equal, equal}

///|
pub struct Wiring {
  src : Ty
  dst : Ty
  mapping : Array[LeafMap]
}

///|
pub fn leaves_of_ty(ty : Ty) -> Array[LeafKind] {
  match ty {
    TyBool => [LKBool]
    TyUnit => [LKUnit]
    TyProd(a, b) => {
      let out = leaves_of_ty(a)
      let rest = leaves_of_ty(b)
      for i in 0..<rest.length() {
        out.push(rest[i])
      }
      out
    }
  }
}

///|
pub fn leaf_count(ty : Ty) -> Int32 {
  leaves_of_ty(ty).length()
}

///|
fn wiring_make(src : Ty, dst : Ty, raw : Array[LeafMap]) -> Wiring {
  // Normalise: Unit outputs are the constant leaf (-1, false).
  let dk = leaves_of_ty(dst)
  let mapping : Array[LeafMap] = []
  for i in 0..<raw.length() {
    match dk[i] {
      LKUnit => mapping.push(LeafMap::{ src_index: -1, neg: false, })
      LKBool => mapping.push(raw[i])
    }
  }
  Wiring::{ src, dst, mapping, }
}

///|
pub fn wiring_id(ty : Ty) -> Wiring {
  let raw : Array[LeafMap] = []
  for i in 0..<leaf_count(ty) {
    raw.push(LeafMap::{ src_index: i, neg: false, })
  }
  wiring_make(ty, ty, raw)
}

///|
pub fn wiring_not() -> Wiring {
  wiring_make(TyBool, TyBool, [LeafMap::{ src_index: 0, neg: true, }])
}

///|
pub fn wiring_swap(a : Ty, b : Ty) -> Wiring {
  let na = leaf_count(a)
  let nb = leaf_count(b)
  let raw : Array[LeafMap] = []
  for j in 0..<nb {
    raw.push(LeafMap::{ src_index: na + j, neg: false, })
  }
  for j in 0..<na {
    raw.push(LeafMap::{ src_index: j, neg: false, })
  }
  wiring_make(TyProd(a, b), TyProd(b, a), raw)
}

///|
pub fn wiring_prod(w1 : Wiring, w2 : Wiring) -> Wiring {
  let raw : Array[LeafMap] = []
  let off = leaf_count(w1.src)
  for i in 0..<w1.mapping.length() {
    raw.push(w1.mapping[i])
  }
  for i in 0..<w2.mapping.length() {
    let m = w2.mapping[i]
    if m.src_index < 0 {
      raw.push(m)
    } else {
      raw.push(LeafMap::{ src_index: m.src_index + off, neg: m.neg, })
    }
  }
  wiring_make(TyProd(w1.src, w2.src), TyProd(w1.dst, w2.dst), raw)
}

///|
pub fn wiring_comp(w1 : Wiring, w2 : Wiring) -> Wiring {
  // w2 after w1: substitute indices, XOR the signs.
  let raw : Array[LeafMap] = []
  for i in 0..<w2.mapping.length() {
    let m2 = w2.mapping[i]
    if m2.src_index < 0 {
      raw.push(LeafMap::{ src_index: -1, neg: false, })
    } else {
      let m1 = w1.mapping[m2.src_index]
      raw.push(LeafMap::{ src_index: m1.src_index, neg: m1.neg != m2.neg, })
    }
  }
  wiring_make(w1.src, w2.dst, raw)
}

///|
pub fn wiring_inv(w : Wiring) -> Wiring {
  let n_src = leaf_count(w.src)
  let raw : Array[LeafMap] = []
  for _i in 0..<n_src {
    raw.push(LeafMap::{ src_index: -1, neg: false, })
  }
  for j in 0..<w.mapping.length() {
    let m = w.mapping[j]
    if m.src_index >= 0 {
      raw[m.src_index] = LeafMap::{ src_index: j, neg: m.neg, }
    }
  }
  wiring_make(w.dst, w.src, raw)
}

///|
pub fn wiring_assoc(a : Ty, b : Ty, c : Ty) -> Wiring {
  // ((A×B)×C) → (A×(B×C)): leaf order is unchanged.
  let src = TyProd(TyProd(a, b), c)
  let raw : Array[LeafMap] = []
  for i in 0..<leaf_count(src) {
    raw.push(LeafMap::{ src_index: i, neg: false, })
  }
  wiring_make(src, TyProd(a, TyProd(b, c)), raw)
}

///|
pub fn wiring_left_unitor(a : Ty) -> Wiring {
  // (Unit×A) → A: skip the leading unit leaf.
  let raw : Array[LeafMap] = []
  for i in 0..<leaf_count(a) {
    raw.push(LeafMap::{ src_index: i + 1, neg: false, })
  }
  wiring_make(TyProd(TyUnit, a), a, raw)
}

///|
pub fn wiring_right_unitor(a : Ty) -> Wiring {
  let raw : Array[LeafMap] = []
  for i in 0..<leaf_count(a) {
    raw.push(LeafMap::{ src_index: i, neg: false, })
  }
  wiring_make(TyProd(a, TyUnit), a, raw)
}

///|
/// Symbolic well-formedness: the Bool leaves form a signed permutation.
pub fn wiring_wf(w : Wiring) -> Bool {
  let sk = leaves_of_ty(w.src)
  let dk = leaves_of_ty(w.dst)
  if w.mapping.length() != dk.length() {
    return false
  }
  let used : Array[Bool] = []
  for _i in 0..<sk.length() {
    used.push(false)
  }
  let mut bool_src = 0
  for i in 0..<sk.length() {
    if sk[i] == LKBool {
      bool_src = bool_src + 1
    }
  }
  let mut bool_dst = 0
  for j in 0..<dk.length() {
    let m = w.mapping[j]
    match dk[j] {
      LKUnit => if m.src_index != -1 || m.neg { return false }
      LKBool => {
        bool_dst = bool_dst + 1
        if m.src_index < 0 || m.src_index >= sk.length() {
          return false
        }
        if sk[m.src_index] != LKBool || used[m.src_index] {
          return false
        }
        used[m.src_index] = true
      }
    }
  }
  bool_src == bool_dst
}

///|
/// Canonical equality of wirings.
pub fn wiring_eq(a : Wiring, b : Wiring) -> Bool {
  if a.src != b.src ||
    a.dst != b.dst ||
    a.mapping.length() != b.mapping.length() {
    return false
  }
  for i in 0..<a.mapping.length() {
    if a.mapping[i] != b.mapping[i] {
      return false
    }
  }
  true
}

// ---------------------------------------------------------------------------
// Evaluation of a wiring on values (leaf flatten / rebuild)
// ---------------------------------------------------------------------------

///|
fn pval_leaves_into(v : PVal, acc : Array[PVal]) -> Unit {
  match v {
    PVPair(a, b) => {
      pval_leaves_into(a, acc)
      pval_leaves_into(b, acc)
    }
    leaf => acc.push(leaf)
  }
}

///|
pub fn flatten_pval(v : PVal) -> Array[PVal] {
  let acc : Array[PVal] = []
  pval_leaves_into(v, acc)
  acc
}

///|
fn build_pval(ty : Ty, leaves : Array[PVal], offset : Int32) -> (PVal, Int32) {
  match ty {
    TyBool => (leaves[offset], offset + 1)
    TyUnit => (PVUnit, offset + 1)
    TyProd(a, b) => {
      let (x, mid) = build_pval(a, leaves, offset)
      let (y, nxt) = build_pval(b, leaves, mid)
      (PVPair(x, y), nxt)
    }
  }
}

///|
pub fn wiring_apply(w : Wiring, v : PVal) -> PVal {
  let input = flatten_pval(v)
  let dk = leaves_of_ty(w.dst)
  let out_leaves : Array[PVal] = []
  for j in 0..<dk.length() {
    match dk[j] {
      LKUnit => out_leaves.push(PVUnit)
      LKBool => {
        let m = w.mapping[j]
        let leaf = if m.src_index >= 0 && m.src_index < input.length() {
          input[m.src_index]
        } else {
          PVBool(false)
        }
        match leaf {
          PVBool(b) => out_leaves.push(PVBool(if m.neg { !b } else { b }))
          other => out_leaves.push(other)
        }
      }
    }
  }
  let (result, _) = build_pval(w.dst, out_leaves, 0)
  result
}

// ---------------------------------------------------------------------------
// Category and symmetric monoidal coherence, as wiring equalities
// ---------------------------------------------------------------------------

///|
pub fn check_wiring_category() -> Bool {
  let x = TyProd(TyBool, TyUnit)
  let y = TyProd(TyUnit, TyBool)
  let f = wiring_swap(TyBool, TyUnit) // X → Y
  let g = wiring_prod(wiring_id(TyUnit), wiring_not()) // Y → Y
  let h = wiring_swap(TyUnit, TyBool) // Y → X
  wiring_wf(f) &&
  wiring_wf(g) &&
  wiring_eq(wiring_comp(wiring_id(x), f), f) &&
  wiring_eq(wiring_comp(f, wiring_id(y)), f) &&
  wiring_eq(
    wiring_comp(wiring_comp(f, g), h),
    wiring_comp(f, wiring_comp(g, h)),
  ) &&
  wiring_eq(wiring_comp(f, wiring_inv(f)), wiring_id(x)) &&
  // tensor is functorial: (f;g) ⊗ id = (f ⊗ id) ; (g ⊗ id)
  wiring_eq(
    wiring_prod(wiring_comp(f, g), wiring_id(TyBool)),
    wiring_comp(
      wiring_prod(f, wiring_id(TyBool)),
      wiring_prod(g, wiring_id(TyBool)),
    ),
  )
}

///|
pub fn check_wiring_coherence() -> Bool {
  let a = TyBool
  let b = TyProd(TyBool, TyUnit)
  let c = TyUnit
  let d = TyBool
  // Pentagon: two routes ((AB)C)D → A(B(CD)) agree.
  let route1 = wiring_comp(
    wiring_assoc(TyProd(a, b), c, d),
    wiring_assoc(a, b, TyProd(c, d)),
  )
  let route2 = wiring_comp(
    wiring_comp(
      wiring_prod(wiring_assoc(a, b, c), wiring_id(d)),
      wiring_assoc(a, TyProd(b, c), d),
    ),
    wiring_prod(wiring_id(a), wiring_assoc(b, c, d)),
  )
  if !wiring_eq(route1, route2) {
    return false
  }
  // Triangle: ((A×1)×B) → A×B, either via unitors directly or via assoc.
  let tri_left = wiring_prod(wiring_right_unitor(a), wiring_id(b))
  let tri_right = wiring_comp(
    wiring_assoc(a, TyUnit, b),
    wiring_prod(wiring_id(a), wiring_left_unitor(b)),
  )
  if !wiring_eq(tri_left, tri_right) {
    return false
  }
  // Hexagon: two routes (A×B)×C → B×(C×A) using assoc + braiding agree.
  let hex1 = wiring_comp(
    wiring_comp(wiring_assoc(a, b, c), wiring_swap(a, TyProd(b, c))),
    wiring_assoc(b, c, a),
  )
  let hex2 = wiring_comp(
    wiring_comp(
      wiring_prod(wiring_swap(a, b), wiring_id(c)),
      wiring_assoc(b, a, c),
    ),
    wiring_prod(wiring_id(b), wiring_swap(a, c)),
  )
  wiring_eq(hex1, hex2) &&
  wiring_eq(
    wiring_comp(wiring_swap(a, b), wiring_swap(b, a)),
    wiring_id(TyProd(a, b)),
  )
}
